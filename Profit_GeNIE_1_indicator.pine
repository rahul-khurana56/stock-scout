//@version=5
indicator("RSI ADX DI Info Panel, EMA Signals, Weekly VWAP, and Delta Zones", shorttitle="Profit GeNIE 1", overlay=true, max_lines_count=200, max_labels_count=200, max_boxes_count=200)

// --- Inputs ---
rsiLength       = input.int(14,    title="RSI Length",               minval=1)
adxLength       = input.int(14,    title="ADX Length",               minval=1)
emaLength       = input.int(33,    title="EMA Length",               minval=1)
panelPosition   = input.string("top_right", title="Panel Position",  options=["top_left","top_center","top_right","bottom_left","bottom_center","bottom_right","center_left"])
showWeeklyVWAP  = input(true,      title="Show Weekly VWAP")
std1            = input.float(1,   title="STDEV 1",                  step=0.1)
showPrev        = input(false,     title="Show Previous VWAP")
showPrevBand    = input(false,     title="Show Previous STDEV = 1 Bands")
minBarsCooldown = input.int(15,     title="Min Bars Between Signals",  minval=1)
breakoutLookback = input.int(15, title="Breakout Lookback (bars)", minval=2)
volumeLookback    = input.int(20, title="Volume Avg Lookback", minval=5)
volumeMultiplier  = input.float(1.3, title="Volume Spike Multiplier", step=0.1)
useVolumeFilter   = input.bool(true, title="Require Volume Spike for TREND")

// --- NEW: Trend/Scalp Classification Inputs ---
useHTFFilter    = input.bool(true, title="Require 15m HTF Alignment for TREND")
htfTimeframe    = input.timeframe("15", title="HTF Timeframe")
adxSlopeBars    = input.int(3, title="ADX Slope Lookback (bars)", minval=1)
useVWAPFilter   = input.bool(true, title="Require VWAP Side for TREND")

// --- NEW: Scalp Engine Inputs (Setup 1a: 21-EMA Pullback Continuation) ---
enablePullbackScalps = input.bool(true,  title="Enable 21-EMA Pullback Scalps", group="Scalp Engine")
maxDailyScalps       = input.int(3,      title="Max Scalps Per Day (Quota)", minval=1, maxval=10, group="Scalp Engine", tooltip="Limits pullback scalp signals per trading day to prevent overtrading.")
rejectionWickPct     = input.float(0.45, title="Min Rejection Wick % (Pullback)", step=0.05, minval=0.1, maxval=0.9, group="Scalp Engine", tooltip="Requires candle to have >= 45% wick rejecting off the 21-EMA ribbon.")
minDiSpreadScalp     = input.float(6.0,  title="Min DI Spread Gap (Scalp)", minval=0.0, step=0.5, group="Scalp Engine", tooltip="Requires significant gap between +DI and -DI (at least 6 pts) to strictly filter out narrow/tangled lines in sideways chop.")
minAdxScalp          = input.float(18.0, title="Min ADX for Scalp", minval=0.0, step=1.0, group="Scalp Engine", tooltip="Ensures minimum baseline momentum before taking a pullback scalp.")
minAtrRatioScalp     = input.float(0.60, title="Min ATR Ratio for Scalp", step=0.05, group="Scalp Engine")
maxAtrRatioScalp     = input.float(1.80, title="Max ATR Ratio for Scalp", step=0.05, group="Scalp Engine")

// --- NEW: Key Levels (HTF Support/Resistance) ---
showKeyLevels     = input.bool(true,  title="Show Key Levels (Hourly + Daily S/R)", group="Key Levels")
hourlyLookback    = input.int(30, title="Hourly Swing Lookback (bars)", minval=2, group="Key Levels", tooltip="Number of completed hourly bars scanned for the swing high/low, e.g. 30 ≈ last week for an index that trades ~6 hourly bars/day. Larger = more significant but older levels; smaller = more reactive to just today/yesterday.")
levelProximityATR = input.float(0.5,  title="Near-Level Threshold (x ATR, feeds Quality)", step=0.1, group="Key Levels")
dailyLevelColor   = input.color(color.new(color.fuchsia, 10), title="Daily Level Color",  group="Key Levels")
hourlyLevelColor  = input.color(color.new(#00BCD4, 10),        title="Hourly Level Color", group="Key Levels")

// --- EMA ---
emaHigh = ta.ema(close, emaLength)
emaLow  = ta.ema(low,   emaLength)

// --- Delta Zone Inputs ---
showDeltaZones = input(true,  title="Show Delta Zones")
stddevlevel    = input.float(3.5, title="Delta Std Dev",             step=0.5)
stddevlookback = input.int(20,    title="Delta Std Dev Lookback")
buyBoxColor    = input.color(color.new(color.green, 83), title="Buy Box Color")
sellBoxColor   = input.color(color.new(color.red,   83), title="Sell Box Color")
showBuyBoxes   = input.bool(true,  title="Show Buy Boxes")
showSellBoxes  = input.bool(true,  title="Show Sell Boxes")

// --- RSI ---
rsiValue = ta.rsi(close, rsiLength)

// --- ADX / DI ---
getADXDI(length) =>
    trueRange  = ta.tr(true)
    changeHigh = ta.change(high)
    changeLow  = -ta.change(low)
    plusDM  = na(changeHigh) ? na : (changeHigh > changeLow and changeHigh > 0 ? changeHigh : 0)
    minusDM = na(changeLow)  ? na : (changeLow > changeHigh and changeLow  > 0 ? changeLow  : 0)
    atr     = ta.rma(trueRange, length)
    plusDI  = 100 * ta.rma(plusDM,  length) / atr
    minusDI = 100 * ta.rma(minusDM, length) / atr
    dx      = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
    adxValue = ta.rma(dx, length)
    [adxValue, plusDI, minusDI]

[adxVal, plusDiVal, minusDiVal] = getADXDI(adxLength)

// ================== NEW: HTF ALIGNMENT (15-min) ==================
htfEMA = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, emaLength), lookahead=barmerge.lookahead_off)
[htfADX, htfPlusDI, htfMinusDI] = request.security(syminfo.tickerid, htfTimeframe, getADXDI(adxLength), lookahead=barmerge.lookahead_off)
htfClose = request.security(syminfo.tickerid, htfTimeframe, close, lookahead=barmerge.lookahead_off)

htfBullish = htfClose > htfEMA and htfPlusDI > htfMinusDI
htfBearish = htfClose < htfEMA and htfMinusDI > htfPlusDI
// ===================================================================

// --- Trend Score ---
//V1
// rsiComponent = rsiValue / 100

// diComponent = math.max(plusDiVal - minusDiVal, 0) / 40

// adxComponent = adxVal / 50

// blrComponent = close > ta.ema(low, 21) ? 0.25 : 0.0

// momentumComponent = math.max(rsiValue - rsiValue[1], 0) / 20

// trendScoreRaw =
//      (rsiComponent * 1.0) +
//      (diComponent * 0.9) +
//      (adxComponent * 0.7) +
//      blrComponent +
//      momentumComponent

// trendScore = math.round(trendScoreRaw * 10) / 10

// ===== Trend Score v2 =====

// RSI Strength
rsiScore =
     rsiValue >= 65 ? 1.0 :
     rsiValue >= 55 ? 0.7 :
     rsiValue >= 50 ? 0.4 : 0.0

// ADX Strength
adxScore =
     adxVal >= 30 ? 1.0 :
     adxVal >= 20 ? 0.6 :
     adxVal >= 15 ? 0.3 : 0.0

// DI Dominance
diSpread = plusDiVal - minusDiVal

diScore =
     math.max(math.min(diSpread, 30), 0) / 30

// EMA Trend
emaScore = close > emaHigh ? 1.0 : 0.0

trendScoreRaw =
     rsiScore +
     adxScore +
     diScore +
     emaScore

trendScore = math.round(trendScoreRaw * 10) / 10

// ======================
// SHORT TREND SCORE
// ======================

bearDiSpread = minusDiVal - plusDiVal

shortDiScore =
     math.max(math.min(bearDiSpread, 30), 0) / 30

shortEmaScore =
     close < emaLow ? 1.0 : 0.0

shortRsiScore =
     rsiValue <= 35 ? 1.0 :
     rsiValue <= 45 ? 0.7 :
     rsiValue <= 50 ? 0.4 : 0.0

shortTrendScore =
     shortRsiScore +
     adxScore +
     shortDiScore +
     shortEmaScore

shortTrendScore :=
     math.round(shortTrendScore * 10) / 10

// ================== NEW: ADX SLOPE + DI SPREAD EXPANSION ==================
adxSlopeUp = adxVal > adxVal[adxSlopeBars]

diSpreadExpandingUp   = diSpread > diSpread[adxSlopeBars]
diSpreadExpandingDown = bearDiSpread > bearDiSpread[adxSlopeBars]
// ============================================================================

// --- ATR Length ---
atrLength = timeframe.period == "5"  ? 14 :timeframe.period == "15" ? 10 :timeframe.period == "30" ? 9  :timeframe.period == "45" ? 8  :timeframe.period == "60" ? 7  : 14

// --- Momentum ---
momentumCategory(adx, plusDI, minusDI) =>
    if adx < 20
        "Weak"
    else if adx >= 20 and adx < 25
        plusDI > minusDI ? "Trend Init(SOR-L)" : "Trend Init(SOR-S)"
    else if adx >= 25
        plusDI > minusDI ? "Strong(L)" : "Strong(S)"
    else
        "Undefined"

momentum = momentumCategory(adxVal, plusDiVal, minusDiVal)

// --- Market Type ---
marketType = "Sideways"
if adxVal > 25 and plusDiVal > minusDiVal and rsiValue > 60
    marketType := "Strong Bullish"
else if adxVal < 25 and plusDiVal > minusDiVal and rsiValue > 50
    marketType := "Weak Bullish"
else if adxVal > 25 and minusDiVal > plusDiVal and rsiValue < 40
    marketType := "Strong Bearish"
else if adxVal < 25 and minusDiVal > plusDiVal and rsiValue < 50
    marketType := "Weak Bearish"
else if adxVal < 20
    marketType := "Sideways"

// --- Signal State (declared early for table use) ---
var bool scoutLongActive  = false
var bool scoutShortActive = false
var bool longConfirmed    = false
var bool shortConfirmed   = false
var int  lastLongBar      = 0
var int  lastShortBar     = 0
var bool longLabelCreated  = false    
var bool shortLabelCreated = false    
var int  dailyScalpCount   = 0

// --- NEW: Trade Quality State ---
var string tradeQuality = "N/A"

// --- Active Trade Management ---
var float tradeEntry = na
var float activeSL = na

var int tradeDirection = 0
// 1 = BUY
// -1 = SELL

var float tp1 = na
var float tp2 = na
var float tp3 = na
var float tp4 = na
var float tp5 = na

var string nextTargetText = "N/A"
var string activeTradeText = "NONE"
var line slLine  = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na
var line tp4Line = na
var line tp5Line = na

var label tp1Label = na
var label tp2Label = na
var label tp3Label = na
var label tp4Label = na
var label tp5Label = na
var label slLabel  = na

atrValue = ta.atr(atrLength)
// --- ATR Study ---
atrAvg20 = ta.sma(atrValue, 20)
atrRatio = atrAvg20 != 0 ? atrValue / atrAvg20 : na
atrChangePct = atrValue[1] != 0 ? ((atrValue - atrValue[1]) / atrValue[1]) * 100 : na

atrRising = atrValue > atrValue[1]
atrTrendText = atrRising ? "↑ Rising" : "↓ Falling"

// ================== NEW: KEY LEVELS (HTF Support/Resistance) ==================
// Previous completed Daily and Hourly high/low, fetched with the [1] offset +
// lookahead_on so we only ever reference a fully closed HTF bar (no repaint).
prevDayHigh  = request.security(syminfo.tickerid, "D",  high[1], lookahead=barmerge.lookahead_on)
prevDayLow   = request.security(syminfo.tickerid, "D",  low[1],  lookahead=barmerge.lookahead_on)
prevHourHigh = request.security(syminfo.tickerid, "60", ta.highest(high, hourlyLookback)[1], lookahead=barmerge.lookahead_on)
prevHourLow  = request.security(syminfo.tickerid, "60", ta.lowest(low, hourlyLookback)[1],   lookahead=barmerge.lookahead_on)

// Always computed (not gated by a toggle) — feeds the existing TREND/SCALP Quality
// classification below rather than hard-blocking a signal on its own.
nearResistance = (not na(prevDayHigh)  and math.abs(close - prevDayHigh)  <= levelProximityATR * atrValue) or
     (not na(prevHourHigh) and math.abs(close - prevHourHigh) <= levelProximityATR * atrValue)

nearSupport = (not na(prevDayLow)  and math.abs(close - prevDayLow)  <= levelProximityATR * atrValue) or
     (not na(prevHourLow) and math.abs(close - prevHourLow) <= levelProximityATR * atrValue)

keyLevelStatusText = nearResistance ? "⚠ Near Res" : nearSupport ? "⚠ Near Sup" : "Clear"
// ================================================================================

// --- Table ---
var table tableInfo = na
if na(tableInfo)
    tablePosition = switch panelPosition
        "top_left"      => position.top_left
        "top_center"    => position.top_center
        "top_right"     => position.top_right
        "bottom_left"   => position.bottom_left
        "bottom_center" => position.bottom_center
        "bottom_right"  => position.bottom_right
        "center_left"   => position.middle_left
        =>                 position.top_right
    tableInfo := table.new(tablePosition, 2, 15)

cell(col, row, txt, bgcolor) =>
    table.cell(tableInfo, col, row, txt, bgcolor=bgcolor, text_color=color.black)

cell(0, 0, "Indicator", color.new(color.black,  90))
cell(1, 0, "Value",     color.new(color.black,  90))

cell(0, 1, "RSI",       color.new(color.blue,   90))
cell(1, 1, str.tostring(rsiValue,   "#.##"), color.new(color.blue,   90))

cell(0, 2, "ADX",       color.new(color.gray,   90))
cell(1, 2, str.tostring(adxVal,     "#.##"), color.new(color.gray,   90))

cell(0, 3, "TS", color.new(color.purple, 90))
cell(1, 3, str.tostring(trendScore, "#.#"), color.new(color.purple, 90))

cell(0, 4, "ATR", color.new(color.fuchsia, 90))
cell(1, 4, str.tostring(atrValue, "#.##"), color.new(color.fuchsia, 90))

cell(0, 5, "ATR Ratio", color.new(color.fuchsia, 90))
cell(1, 5, str.tostring(atrRatio, "#.##"), color.new(color.fuchsia, 90))

cell(0, 6, "ATR Change", color.new(color.fuchsia, 90))
cell(1, 6, str.tostring(atrChangePct, "#.##") + "%", color.new(color.fuchsia, 90))

cell(0, 7, "ATR Trend", color.new(color.fuchsia, 90))
cell(1, 7, atrTrendText, color.new(color.fuchsia, 90))


// EMA cross conditions (with ADX filter to avoid weak market false triggers)
crossAboveEMA  = ta.crossover(close,  emaHigh) and adxVal >= 20
crossBelowEMA  = ta.crossunder(close, emaLow)  and adxVal >= 20
priceAboveEMAH = close > emaHigh
priceBelowEMAL = close < emaLow
adxIncreasing  = adxVal > nz(adxVal[1], 0)
nBarHigh    = ta.highest(high, breakoutLookback)[1]
nBarLow     = ta.lowest(low, breakoutLookback)[1]
avgVolume   = ta.sma(volume, volumeLookback)
volumeSpike = volume > avgVolume * volumeMultiplier

/// ===== BLR Ribbon =====

// Inputs
showBLR   = input.bool(true, "Plot BLR Moving Average")
blrColor  = input.color(color.green, "BLR Color")
blrShading = input.int(65, "BLR Shading", minval=0, maxval=100)

// BLR Logic
length = 21

upper = ta.ema(ta.ema(close, 21), 2)
lower = ta.ema(low, 21)

emaMid = (upper + lower) / 2

// Plots
plot(showBLR ? emaMid : na, color=color.blue, title="Midline", display=display.none)

p1 = plot(showBLR ? upper : na, color=blrColor, title="Upper Band", display=display.none)

p2 = plot(showBLR ? lower : na, color=blrColor, title="Lower Band", display=display.none)

fill(p1, p2, color=color.new(blrColor, blrShading))

// --- Weekly VWAP ---
newSessionW = ta.change(time("W"))
newSessionD = ta.change(time("D"))
newSessionH = ta.change(time("60"))

getVWAP(newSession) =>
    var float p   = na
    var float vol = na
    var float Sn  = na
    var float v   = na
    var float std = na
    p   := newSession ? hlc3*volume : (na(p)   ? hlc3*volume : p+hlc3*volume)
    vol := newSession ? volume      : (na(vol)  ? volume      : vol+volume)
    v   := p / vol
    Sn  := newSession ? 0 : (na(Sn) ? 0 : Sn + volume*(hlc3-v[1])*(hlc3-v))
    std := math.sqrt(Sn / vol)
    [v, std]

getVWAPDaily(newSession) =>
    var float p2   = na
    var float vol2 = na
    var float Sn2  = na
    var float v2   = na
    var float std2 = na
    p2   := newSession ? hlc3*volume : (na(p2)   ? hlc3*volume : p2+hlc3*volume)
    vol2 := newSession ? volume      : (na(vol2)  ? volume      : vol2+volume)
    v2   := p2 / vol2
    Sn2  := newSession ? 0 : (na(Sn2) ? 0 : Sn2 + volume*(hlc3-v2[1])*(hlc3-v2))
    std2 := math.sqrt(Sn2 / vol2)
    [v2, std2]

[vW, stdevW] = getVWAP(newSessionW)
[vD, stdevD] = getVWAPDaily(newSessionD)

vwPlot = showWeeklyVWAP ? vW : na
plot(vwPlot, title="VWAP - Weekly", color=color.blue, linewidth=2, style=plot.style_line)

prevVWAP     = ta.valuewhen(newSessionW, vW[1], 0)
prevVWAPPlot = showPrev ? prevVWAP : na
plot(prevVWAPPlot, title="Previous VWAP - Weekly", color=#40E20099, style=plot.style_cross, linewidth=2)

prevVWAPS1Up = showPrevBand ? prevVWAP + std1*stdevW[1] : na
prevVWAPS1Dn = showPrevBand ? prevVWAP - std1*stdevW[1] : na
plot(prevVWAPS1Up, title="Previous VWAP S1 - Weekly (Up)",   color=#40E20099, style=plot.style_line, linewidth=1)
plot(prevVWAPS1Dn, title="Previous VWAP S1 - Weekly (Down)", color=#40E20099, style=plot.style_line, linewidth=1)

// --- Daily VWAP Value Zone ---
bool  showDailyVWAP  = input.bool(true,  "Show Daily VWAP")
color dailyVWAPColor = input.color(color.yellow, "Daily VWAP Color")
bool  showValueZone  = input.bool(true,  "Show Value Zone")
color valueZoneColor = input.color(color.new(color.blue, 85), "Value Zone Fill")
float zoneMultiplier = input.float(0.2,  "Zone Multiplier", step=0.1)

float dailyVWAP = ta.vwap(hlc3)
plot(showDailyVWAP ? dailyVWAP : na, title="Daily VWAP", color=dailyVWAPColor, linewidth=2)

prevDayRange = prevDayHigh - prevDayLow

dailyOpenLocal = request.security(syminfo.tickerid, "D", open, lookahead=barmerge.lookahead_on)
adjustedChangeLocal =
     str.contains(syminfo.ticker, "BANK")  ? 0.0017 :
     str.contains(syminfo.ticker, "NIFTY") ? 0.0025 :
     dailyOpenLocal < 100   ? 0.0200 :
     dailyOpenLocal < 500   ? 0.0150 :
     dailyOpenLocal < 1000  ? 0.0120 :
     dailyOpenLocal < 2000  ? 0.0100 :
     dailyOpenLocal < 5000  ? 0.0100 :
     dailyOpenLocal < 15000 ? 0.0036 : 0.0025

bzLocal       = dailyOpenLocal * (1 - adjustedChangeLocal)
valueZoneHigh = showValueZone ? bzLocal : na
valueZoneLow  = showValueZone ? bzLocal - (prevDayRange * zoneMultiplier) : na

pZoneUp = plot(valueZoneHigh, color=color.new(color.blue,100), title="Value Zone Upper")
pZoneDn = plot(valueZoneLow,  color=color.new(color.blue,100), title="Value Zone Lower")
fill(pZoneUp, pZoneDn, color=valueZoneColor, title="Value Zone Fill")

// --- Breakout Zones ---
dailyOpen = request.security(syminfo.tickerid, "D", open, lookahead=barmerge.lookahead_on)
dayHigh   = request.security(syminfo.tickerid, "D", high, lookahead=barmerge.lookahead_on)
dayLow    = request.security(syminfo.tickerid, "D", low,  lookahead=barmerge.lookahead_on)

k    = str.contains(syminfo.ticker, "BANK")  ? 0.10 :
       str.contains(syminfo.ticker, "NIFTY") ? 0.25 :
       str.contains(syminfo.prefix, "MCX")   ? 0.05 : 0.10
bpoc = dailyOpen + k * (dayHigh - dayLow)

adjustedChange =
     str.contains(syminfo.ticker, "BANK")  ? 0.0017 :
     str.contains(syminfo.ticker, "NIFTY") ? 0.0025 :
     str.contains(syminfo.prefix, "MCX")   ? 0.0040 :
     str.contains(syminfo.ticker, "SENSEX") ? 0.0015 :
     dailyOpen < 100   ? 0.0200 :
     dailyOpen < 500   ? 0.0150 :
     dailyOpen < 1000  ? 0.0120 :
     dailyOpen < 2000  ? 0.0100 :
     dailyOpen < 5000  ? 0.0100 :
     dailyOpen < 15000 ? 0.0036 : 0.0025

bbz     = dailyOpen * (1 + adjustedChange)
bz      = dailyOpen * (1 - adjustedChange)
midLine = (bbz + bz) / 2

// --- Signal Setup Conditions ---
longSetup =
     priceAboveEMAH and
     plusDiVal > minusDiVal and
     rsiValue > 55  and
     (adxVal >= 20 or adxIncreasing) and
     trendScore >= 2.5 and
     close > bbz and
     //close > high[1]
     close > nBarHigh
     

shortSetup =
     priceBelowEMAL and
     minusDiVal > plusDiVal and
     rsiValue < 45  and
     (adxVal >= 20 or adxIncreasing) and
     shortTrendScore >= 2.5 and
     close < bz and
     //close < low[1]
     close < nBarLow

confirmedLongCondition =
     longSetup and
     close > emaHigh

confirmedShortCondition =
     shortSetup and
     close < emaLow

// --- NEW: Setup 1a (21-EMA Pullback-Continuation Scalp Conditions) ---
candleRange = math.max(high - low, syminfo.mintick)
longWick    = (close - low) / candleRange
shortWick   = (high - close) / candleRange

touchLowerEma = low <= lower and close > lower
touchUpperEma = high >= upper and close < upper

atrRatioValid = not na(atrRatio) and atrRatio >= minAtrRatioScalp and atrRatio <= maxAtrRatioScalp
adxScalpValid = adxVal >= minAdxScalp

// Strict DI dominance and minimum spread gap (filters narrow / tangled chop)
diBullishScalp = plusDiVal > minusDiVal and diSpread >= minDiSpreadScalp and diSpreadExpandingUp
diBearishScalp = minusDiVal > plusDiVal and bearDiSpread >= minDiSpreadScalp and diSpreadExpandingDown

scalpPullbackLongCondition = enablePullbackScalps and touchLowerEma and (longWick >= rejectionWickPct) and diBullishScalp and adxScalpValid and (close > close[1]) and atrRatioValid and (not nearResistance) and (not useVWAPFilter or close > dailyVWAP) and (dailyScalpCount < maxDailyScalps)

scalpPullbackShortCondition = enablePullbackScalps and touchUpperEma and (shortWick >= rejectionWickPct) and diBearishScalp and adxScalpValid and (close < close[1]) and atrRatioValid and (not nearSupport) and (not useVWAPFilter or close < dailyVWAP) and (dailyScalpCount < maxDailyScalps)

// --- Rearm Conditions ---
// bool longRearmCondition =
//      (trendScore < 1.0 and trendScore[1] < 1.0) or
//      (minusDiVal > plusDiVal and adxVal > 20 and minusDiVal[1] > plusDiVal[1])

// bool shortRearmCondition =
//      (trendScore > 2.5 and trendScore[1] > 2.5) or
//      (plusDiVal > minusDiVal and adxVal > 20 and plusDiVal[1] > minusDiVal[1])

bool longRearmCondition =
     (rsiValue < 50 and close < emaHigh) 
     

bool shortRearmCondition =
     (rsiValue > 50 and close > emaLow) 

deleteTradeLines() =>
    if not na(tp1Label)
        label.delete(tp1Label)

    if not na(tp2Label)
        label.delete(tp2Label)

    if not na(tp3Label)
        label.delete(tp3Label)

    if not na(tp4Label)
        label.delete(tp4Label)

    if not na(tp5Label)
        label.delete(tp5Label)

    if not na(slLabel)
        label.delete(slLabel)

    if not na(slLine)
        line.delete(slLine)

    if not na(tp1Line)
        line.delete(tp1Line)

    if not na(tp2Line)
        line.delete(tp2Line)

    if not na(tp3Line)
        line.delete(tp3Line)

    if not na(tp4Line)
        line.delete(tp4Line)

    if not na(tp5Line)
        line.delete(tp5Line)
   

// --- Day Reset ---
if ta.change(time("D"))
    lastLongBar       := 0
    lastShortBar      := 0
    scoutLongActive   := false
    scoutShortActive  := false
    longConfirmed     := false
    shortConfirmed    := false
    longLabelCreated  := false    // ← ADD
    shortLabelCreated := false    // ← ADD
    dailyScalpCount   := 0
    deleteTradeLines()

    tradeDirection := 0
    tradeEntry := na
    activeSL := na

    tp1 := na
    tp2 := na
    tp3 := na
    tp4 := na
    tp5 := na

    activeTradeText := "NONE"
    nextTargetText := "N/A"
    tradeQuality := "N/A"

// --- Rearm (only when setup NOT active) ---
if longRearmCondition and not longSetup
    scoutLongActive := false
    longConfirmed   := false

if shortRearmCondition and not shortSetup
    scoutShortActive := false
    shortConfirmed   := false

// --- Scout & Confirm Logic ---
scoutingLong  = false
scoutingShort = false
confirmedLong  = false
confirmedShort = false
confirmedPullbackLong  = false
confirmedPullbackShort = false

if longSetup and not scoutLongActive and not longConfirmed
    scoutingLong    := true
    scoutLongActive := true

if shortSetup and not scoutShortActive and not shortConfirmed
    scoutingShort    := true
    scoutShortActive := true

// Confirm only on bar CLOSE (barstate.isconfirmed)
if barstate.isconfirmed and confirmedLongCondition and scoutLongActive and not longConfirmed and (bar_index - lastLongBar >= minBarsCooldown)
    confirmedLong  := true
    longConfirmed  := true
    lastLongBar    := bar_index

if barstate.isconfirmed and confirmedShortCondition and scoutShortActive and not shortConfirmed and (bar_index - lastShortBar >= minBarsCooldown)
    confirmedShort  := true
    shortConfirmed  := true
    lastShortBar    := bar_index

// Setup 1a: 21-EMA Pullback Scalp Confirmation
if barstate.isconfirmed and scalpPullbackLongCondition and not longConfirmed and not confirmedLong and (bar_index - lastLongBar >= minBarsCooldown)
    confirmedPullbackLong := true
    longConfirmed         := true
    lastLongBar           := bar_index
    dailyScalpCount       := dailyScalpCount + 1

if barstate.isconfirmed and scalpPullbackShortCondition and not shortConfirmed and not confirmedShort and (bar_index - lastShortBar >= minBarsCooldown)
    confirmedPullbackShort := true
    shortConfirmed         := true
    lastShortBar           := bar_index
    dailyScalpCount        := dailyScalpCount + 1

// --- Scout & Confirmed Labels ---
var scoutLongLabel  = label(na)
var scoutShortLabel = label(na)
var int scoutLongBar  = na
var int scoutShortBar = na

// Create scout label ONCE when scouting first triggers
if scoutingLong and not longLabelCreated
    label.delete(scoutLongLabel)
    scoutLongBar     := bar_index
    longLabelCreated := true
    scoutLongLabel   := label.new(x=bar_index, y=low, text="❄ BUY?",
         yloc=yloc.belowbar, color=color.new(#2196F3, 20),
         textcolor=color.white, style=label.style_label_up, size=size.small)

if scoutingShort and not shortLabelCreated
    label.delete(scoutShortLabel)
    scoutShortBar     := bar_index
    shortLabelCreated := true
    scoutShortLabel   := label.new(x=bar_index, y=high, text="❄ SELL?",
         yloc=yloc.abovebar, color=color.new(#2196F3, 20),
         textcolor=color.white, style=label.style_label_down, size=size.small)

// Reset label flag when rearm happens
if longRearmCondition and not longSetup
    longLabelCreated := false

if shortRearmCondition and not shortSetup
    shortLabelCreated := false

// On confirmation — update color of existing label
if confirmedLong or confirmedPullbackLong
    tradeDirection := 1
    tradeEntry := close
    // Reset previous trade values
    tp1 := na
    tp2 := na
    tp3 := na
    tp4 := na
    tp5 := na

    // Reset old trade state
    nextTargetText := "N/A"

    activeTradeText := "BUY"

    // ================== NEW: TREND vs SCALP CLASSIFICATION ==================
    if confirmedPullbackLong
        tradeQuality := "SCALP"
    else
        qualityLongOK = (not useHTFFilter or htfBullish) and adxSlopeUp and diSpreadExpandingUp and (not useVWAPFilter or close > dailyVWAP) and (not useVolumeFilter or volumeSpike) and not nearResistance
        tradeQuality := qualityLongOK ? "TREND" : "SCALP"
    // ==========================================================================

    tpStep = tradeQuality == "TREND" ? 1.0 : 0.5
    activeSL := tradeEntry - (tradeQuality == "TREND" ? atrValue : atrValue * 0.75)

    tp1 := tradeEntry + atrValue * (tpStep * 1.0)
    tp2 := tradeEntry + atrValue * (tpStep * 2.0)
    tp3 := tradeEntry + atrValue * (tpStep * 3.0)
    tp4 := tradeEntry + atrValue * (tpStep * 4.0)
    tp5 := tradeEntry + atrValue * (tpStep * 5.0)

    deleteTradeLines()

    slLine  := line.new(bar_index, activeSL, bar_index + 75, activeSL, color=color.red, width=2)
    tp1Line := line.new(bar_index, tp1, bar_index + 75, tp1, color=color.blue, style=line.style_dashed)
    tp2Line := line.new(bar_index, tp2, bar_index + 75, tp2, color=color.blue, style=line.style_dashed)
    tp3Line := line.new(bar_index, tp3, bar_index + 75, tp3, color=color.blue, style=line.style_dashed)
    tp4Line := line.new(bar_index, tp4, bar_index + 75, tp4, color=color.green, style=line.style_dashed)
    tp5Line := line.new(bar_index, tp5, bar_index + 75, tp5, color=color.green, style=line.style_dashed)
    tp1Label := label.new(bar_index + 75, tp1, "TP1 (" + str.tostring(tpStep * 1.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(66,133,244), textcolor=color.white, size=size.small)
    tp2Label := label.new(bar_index + 75, tp2, "TP2 (" + str.tostring(tpStep * 2.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(66,133,244), textcolor=color.white, size=size.small)
    tp3Label := label.new(bar_index + 75, tp3, "TP3 (" + str.tostring(tpStep * 3.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(66,133,244), textcolor=color.white, size=size.small)
    tp4Label := label.new(bar_index + 75, tp4, "TP4 (" + str.tostring(tpStep * 4.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(66,133,244), textcolor=color.white, size=size.small)
    tp5Label := label.new(bar_index + 75, tp5, "TP5 (" + str.tostring(tpStep * 5.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(66,133,244), textcolor=color.white, size=size.small)
    slLabel := label.new(bar_index + 75, activeSL, "SL", style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)

    nextTargetText := "TP1 @ " + str.tostring(tp1, "#.##")

    label.delete(scoutLongLabel)
    labelText = confirmedPullbackLong ? "BUY ⚡SCALP (" + str.tostring(dailyScalpCount) + "/" + str.tostring(maxDailyScalps) + ")" : (tradeQuality == "TREND" ? "BUY 🔥T" : "BUY ⚡S")
    labelColor = confirmedPullbackLong ? color.new(#FF9800, 10) : (tradeQuality == "TREND" ? color.new(color.green, 10) : color.new(color.orange, 10))
    label.new(x=bar_index, y=low, text=labelText,
         yloc=yloc.belowbar,
         color=labelColor,
         textcolor=color.white,
         style=label.style_label_up,
         size=size.small)

    longLabelCreated := false

if confirmedShort or confirmedPullbackShort
    tradeDirection := -1
    tradeEntry := close
    // Reset previous trade values
    tp1 := na
    tp2 := na
    tp3 := na
    tp4 := na
    tp5 := na

    // Reset old trade state
    nextTargetText := "N/A"

    activeTradeText := "SELL"

    // ================== NEW: TREND vs SCALP CLASSIFICATION ==================
    if confirmedPullbackShort
        tradeQuality := "SCALP"
    else
        qualityShortOK = (not useHTFFilter or htfBearish) and adxSlopeUp and diSpreadExpandingDown and (not useVWAPFilter or close < dailyVWAP) and (not useVolumeFilter or volumeSpike) and not nearSupport
        tradeQuality := qualityShortOK ? "TREND" : "SCALP"
    // ==========================================================================

    tpStep = tradeQuality == "TREND" ? 1.0 : 0.5
    activeSL := tradeEntry + (tradeQuality == "TREND" ? atrValue : atrValue * 0.75)

    tp1 := tradeEntry - atrValue * (tpStep * 1.0)
    tp2 := tradeEntry - atrValue * (tpStep * 2.0)
    tp3 := tradeEntry - atrValue * (tpStep * 3.0)
    tp4 := tradeEntry - atrValue * (tpStep * 4.0)
    tp5 := tradeEntry - atrValue * (tpStep * 5.0)

    deleteTradeLines()

    slLine  := line.new(bar_index, activeSL, bar_index + 75, activeSL, color=color.red, width=2)

    tp1Line := line.new(bar_index, tp1, bar_index + 75, tp1, color=color.blue, style=line.style_dashed)
    tp2Line := line.new(bar_index, tp2, bar_index + 75, tp2, color=color.blue, style=line.style_dashed)
    tp3Line := line.new(bar_index, tp3, bar_index + 75, tp3, color=color.blue, style=line.style_dashed)
    tp4Line := line.new(bar_index, tp4, bar_index + 75, tp4, color=color.green, style=line.style_dashed)
    tp5Line := line.new(bar_index, tp5, bar_index + 75, tp5, color=color.green, style=line.style_dashed)

    tp1Label := label.new(bar_index + 75, tp1, "TP1 (" + str.tostring(tpStep * 1.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(66,133,244), textcolor=color.white, size=size.small)
    tp2Label := label.new(bar_index + 75, tp2, "TP2 (" + str.tostring(tpStep * 2.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(66,133,244), textcolor=color.white, size=size.small)
    tp3Label := label.new(bar_index + 75, tp3, "TP3 (" + str.tostring(tpStep * 3.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(66,133,244), textcolor=color.white, size=size.small)
    tp4Label := label.new(bar_index + 75, tp4, "TP4 (" + str.tostring(tpStep * 4.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(66,133,244), textcolor=color.white, size=size.small)
    tp5Label := label.new(bar_index + 75, tp5, "TP5 (" + str.tostring(tpStep * 5.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(76,175,80), textcolor=color.white, size=size.small)

    slLabel := label.new(bar_index + 75, activeSL, "SL", style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)

    nextTargetText := "TP1 @ " + str.tostring(tp1, "#.##")

    label.delete(scoutShortLabel)
    labelText = confirmedPullbackShort ? "SELL ⚡SCALP (" + str.tostring(dailyScalpCount) + "/" + str.tostring(maxDailyScalps) + ")" : (tradeQuality == "TREND" ? "SELL 🔥T" : "SELL ⚡S")
    labelColor = confirmedPullbackShort ? color.new(#FF9800, 10) : (tradeQuality == "TREND" ? color.new(color.red, 10) : color.new(color.orange, 10))
    label.new(x=bar_index, y=high, text=labelText,
         yloc=yloc.abovebar, color=labelColor,
         textcolor=color.white, style=label.style_label_down, size=size.small)

    shortLabelCreated := false

if tradeDirection == 1

    if high >= tp1
        label.set_text(tp1Label, "✓ TP1")
        label.set_color(tp1Label, color.green)
        activeSL := tradeEntry
        nextTargetText := "TP2 @ " + str.tostring(tp2, "#")

    if high >= tp2
        label.set_text(tp2Label, "✓ TP2")
        label.set_color(tp2Label, color.green)
        activeSL := tp1
        nextTargetText := "TP3 @ " + str.tostring(tp3, "#")

    if high >= tp3
        label.set_text(tp3Label, "✓ TP3")
        label.set_color(tp3Label, color.green)
        activeSL := tp2
        nextTargetText := "TP4 @ " + str.tostring(tp4, "#")

    if high >= tp4
        label.set_text(tp4Label, "✓ TP4")
        label.set_color(tp4Label, color.green)
        activeSL := tp3
        nextTargetText := "TP5 @ " + str.tostring(tp5, "#")

    if high >= tp5
        label.set_text(tp5Label, "✓ TP5")
        label.set_color(tp5Label, color.green)
        activeSL := tp4
        nextTargetText := "TARGETS COMPLETE"


// --- SELL Target Progression ---
if tradeDirection == -1

    if low <= tp1
        label.set_text(tp1Label, "✓ TP1")
        label.set_color(tp1Label, color.green)
        activeSL := tradeEntry
        nextTargetText := "TP2 @ " + str.tostring(tp2, "#")

    if low <= tp2
        label.set_text(tp2Label, "✓ TP2")
        label.set_color(tp2Label, color.green)
        activeSL := tp1
        nextTargetText := "TP3 @ " + str.tostring(tp3, "#")

    if low <= tp3
        label.set_text(tp3Label, "✓ TP3")
        label.set_color(tp3Label, color.green)
        activeSL := tp2
        nextTargetText := "TP4 @ " + str.tostring(tp4, "#")

    if low <= tp4
        label.set_text(tp4Label, "✓ TP4")
        label.set_color(tp4Label, color.green)
        activeSL := tp3
        nextTargetText := "TP5 @ " + str.tostring(tp5, "#")

    if low <= tp5
        label.set_text(tp5Label, "✓ TP5")
        label.set_color(tp5Label, color.green)
        activeSL := tp4
        nextTargetText := "TARGETS COMPLETE"




// --- Alerts ---
alertcondition(scoutingLong,           title="Scout Long Alert",         message="❄ GET READY - BUY Scout forming on {{ticker}} at {{close}}")
alertcondition(scoutingShort,          title="Scout Short Alert",        message="❄ GET READY - SELL Scout forming on {{ticker}} at {{close}}")
alertcondition(confirmedLong,          title="Confirmed Long Alert",     message="✅ CONFIRMED BUY on {{ticker}} at {{close}}")
alertcondition(confirmedShort,         title="Confirmed Short Alert",    message="✅ CONFIRMED SELL on {{ticker}} at {{close}}")
alertcondition(confirmedPullbackLong,  title="Pullback Scalp Buy Alert", message="⚡ PULLBACK SCALP BUY on {{ticker}} at {{close}}")
alertcondition(confirmedPullbackShort, title="Pullback Scalp Sell Alert",message="⚡ PULLBACK SCALP SELL on {{ticker}} at {{close}}")
anySignal = scoutingLong or scoutingShort or confirmedLong or confirmedShort or confirmedPullbackLong or confirmedPullbackShort

alertcondition(anySignal, title="Any Signal Alert", message="⚡ Signal fired on {{ticker}} at {{close}} - Check chart!")

// --- Delta Zones ---
var float up_delta   = na
var float down_delta = na
var float delta      = na
var float pos_delta  = na
var float neg_delta  = na
var float wickdevup  = na
var float wickdevdn  = na
var bool  huntingup  = na
var bool  huntingdn  = na
var box   buyBox     = na
var box   sellBox    = na

if showDeltaZones
    uptop = high - close
    upbot = open - low
    dntop = high - open
    dnbot = close - low
    up_delta   := upbot - uptop
    down_delta := dntop - dnbot
    delta      := up_delta != 0 ? up_delta : down_delta != 0 ? down_delta : na
    pos_delta  := delta > 0 ? delta : na
    neg_delta  := delta < 0 ? delta : na
    wickdevup  := ta.stdev(pos_delta, stddevlookback) * stddevlevel
    wickdevdn  := ta.stdev(neg_delta, stddevlookback) * -stddevlevel
    huntingup  := pos_delta >= wickdevup
    huntingdn  := neg_delta <= wickdevdn

    if showBuyBoxes and huntingup
        buyBox := box.new(left=bar_index,
             top=(open <= close ? (open+low)/2 : (close+low)/2),
             right=bar_index, bottom=low,
             bgcolor=buyBoxColor, border_width=1, border_color=color.green)
    else if not na(buyBox)
        box.set_right(buyBox, bar_index + 5)

    if showSellBoxes and huntingdn
        sellBox := box.new(left=bar_index, top=high, right=bar_index,
             bottom=(open < close ? (close+high)/2 : (open+high)/2),
             bgcolor=sellBoxColor, border_width=1, border_color=color.rgb(222,11,11))
    else if not na(sellBox)
        box.set_right(sellBox, bar_index + 5)

// --- SE/BE Labels ---
var seLabel = label(na)
var beLabel = label(na)

if showDeltaZones and huntingup
    label.delete(seLabel)
    seLabel := label.new(x=bar_index, y=low, text="❄ SE",
         yloc=yloc.belowbar, color=color.new(color.teal, 20),
         textcolor=color.white, style=label.style_label_right, size=size.small)

if showDeltaZones and huntingdn
    label.delete(beLabel)
    beLabel := label.new(x=bar_index, y=high, text="❄ BE",
         yloc=yloc.abovebar, color=color.new(color.teal, 20),
         textcolor=color.white, style=label.style_label_right, size=size.small)

alertcondition(showDeltaZones and huntingup, title="Sell Exhaustion Alert", message="❄ SE - Sell Exhaustion on {{ticker}} at {{close}}")
alertcondition(showDeltaZones and huntingdn, title="Buy Exhaustion Alert",  message="❄ BE - Buy Exhaustion on {{ticker}} at {{close}}")

// --- Session Lines ---
sessionStart = timestamp("Asia/Kolkata", year, month, dayofmonth, 9, 15)
sessionEnd   = str.contains(syminfo.prefix, "MCX") ?
     timestamp("Asia/Kolkata", year, month, dayofmonth, 23, 30) :
     timestamp("Asia/Kolkata", year, month, dayofmonth, 15, 30)

var line bbzLine     = na
var line bzLine      = na
var line midLineLine = na
var line bpocLine    = na

if time >= sessionStart and time[1] < sessionStart
    if not na(bbzLine)
        line.delete(bbzLine)
        line.delete(bzLine)
        line.delete(midLineLine)
        line.delete(bpocLine)
    bbzLine     := line.new(sessionStart, bbz,     sessionEnd, bbz,     xloc=xloc.bar_time, color=color.green,  width=4)
    bzLine      := line.new(sessionStart, bz,      sessionEnd, bz,      xloc=xloc.bar_time, color=color.red,    width=4)
    midLineLine := line.new(sessionStart, midLine, sessionEnd, midLine, xloc=xloc.bar_time, color=color.blue,   width=1)
    bpocLine    := line.new(sessionStart, bpoc,    sessionEnd, bpoc,    xloc=xloc.bar_time, color=color.orange, width=2)

// ================== NEW: KEY LEVELS PLOTTING (Hourly + Daily S/R) ==================
// Drawn LAST so these lines render on top of the (thicker) session lines above,
// instead of being hidden underneath them.
var line dailyResLine  = na
var line dailySupLine  = na
var line hourlyResLine = na
var line hourlySupLine = na

if showKeyLevels and newSessionD
    if not na(dailyResLine)
        line.delete(dailyResLine)
        line.delete(dailySupLine)
    dailyResLine := line.new(bar_index - 1, prevDayHigh, bar_index, prevDayHigh, extend=extend.right, color=dailyLevelColor, width=2, style=line.style_dashed)
    dailySupLine := line.new(bar_index - 1, prevDayLow,  bar_index, prevDayLow,  extend=extend.right, color=dailyLevelColor, width=2, style=line.style_dashed)

if showKeyLevels and newSessionH
    if not na(hourlyResLine)
        line.delete(hourlyResLine)
        line.delete(hourlySupLine)
    hourlyResLine := line.new(bar_index - 1, prevHourHigh, bar_index, prevHourHigh, extend=extend.right, color=hourlyLevelColor, width=2, style=line.style_dotted)
    hourlySupLine := line.new(bar_index - 1, prevHourLow,  bar_index, prevHourLow,  extend=extend.right, color=hourlyLevelColor, width=2, style=line.style_dotted)

// --- Sticky tags that hug the current bar, same visual language as TP1-5 ---
var label dailyResTag  = na
var label dailySupTag  = na
var label hourlyResTag = na
var label hourlySupTag = na

if showKeyLevels and not na(prevDayHigh)
    if na(dailyResTag)
        dailyResTag := label.new(bar_index, prevDayHigh, "D-Res", style=label.style_label_left, color=dailyLevelColor, textcolor=color.white, size=size.small)
        dailySupTag := label.new(bar_index, prevDayLow,  "D-Sup", style=label.style_label_left, color=dailyLevelColor, textcolor=color.white, size=size.small)
    else
        label.set_xy(dailyResTag, bar_index, prevDayHigh)
        label.set_xy(dailySupTag, bar_index, prevDayLow)
else if not na(dailyResTag)
    label.delete(dailyResTag)
    label.delete(dailySupTag)
    dailyResTag := na
    dailySupTag := na

if showKeyLevels and not na(prevHourHigh)
    if na(hourlyResTag)
        hourlyResTag := label.new(bar_index, prevHourHigh, "H-Res", style=label.style_label_left, color=hourlyLevelColor, textcolor=color.white, size=size.small)
        hourlySupTag := label.new(bar_index, prevHourLow,  "H-Sup", style=label.style_label_left, color=hourlyLevelColor, textcolor=color.white, size=size.small)
    else
        label.set_xy(hourlyResTag, bar_index, prevHourHigh)
        label.set_xy(hourlySupTag, bar_index, prevHourLow)
else if not na(hourlyResTag)
    label.delete(hourlyResTag)
    label.delete(hourlySupTag)
    hourlyResTag := na
    hourlySupTag := na
// =====================================================================================
