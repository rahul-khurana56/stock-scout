//@version=5
indicator("RSI ADX DI Info Panel, EMA Signals, Weekly VWAP, and Delta Zones", shorttitle="Profit GeNIE 1", overlay=true, max_lines_count=200, max_labels_count=200, max_boxes_count=200)

// --- Inputs ---
rsiLength       = input.int(14,    title="RSI Length",               minval=1)
adxLength       = input.int(14,    title="ADX Length",               minval=1)
emaLength       = input.int(33,    title="EMA Length",               minval=1)
panelPosition   = input.string("top_right", title="Panel Position",  options=["top_left","top_center","top_right","bottom_left","bottom_center","bottom_right","center_left"])
showWeeklyVWAP  = input(true,      title="Show Weekly VWAP")
std1            = input.float(1,   title="STDEV 1",                  step=0.1)
showPrev        = input(false,     title="Show Previous VWAP")
showPrevBand    = input(false,     title="Show Previous STDEV = 1 Bands")
minBarsCooldown = input.int(15,     title="Min Bars Between Signals",  minval=1)
breakoutLookback = input.int(15, title="Breakout Lookback (bars)", minval=2)
volumeLookback    = input.int(20, title="Volume Avg Lookback", minval=5)
volumeMultiplier  = input.float(1.3, title="Volume Spike Multiplier", step=0.1)
useVolumeFilter   = input.bool(true, title="Require Volume Spike for TREND")

// --- NEW: Trend/Scalp Classification Inputs ---
useHTFFilter    = input.bool(true, title="Require 15m HTF Alignment for TREND")
htfTimeframe    = input.timeframe("15", title="HTF Timeframe")
adxSlopeBars    = input.int(3, title="ADX Slope Lookback (bars)", minval=1)
useVWAPFilter   = input.bool(true, title="Require VWAP Side for TREND")

// --- NEW: Scalp Engine Inputs (Setup 1a: 21-EMA Pullback Continuation) ---
enablePullbackScalps = input.bool(true,  title="Enable 21-EMA Pullback Scalps", group="Scalp Engine")
maxDailyScalps       = input.int(3,      title="Max Scalps Per Day (Quota)", minval=1, maxval=10, group="Scalp Engine", tooltip="Limits pullback scalp signals per trading day to prevent overtrading.")
rejectionWickPct     = input.float(0.45, title="Min Rejection Wick % (Pullback)", step=0.05, minval=0.1, maxval=0.9, group="Scalp Engine", tooltip="Requires candle to have >= 45% wick rejecting off the 21-EMA ribbon.")
minDiSpreadScalp     = input.float(6.0,  title="Min DI Spread Gap (Scalp)", minval=0.0, step=0.5, group="Scalp Engine", tooltip="Requires significant gap between +DI and -DI (at least 6 pts) to strictly filter out narrow/tangled lines in sideways chop.")
minAdxScalp          = input.float(18.0, title="Min ADX for Scalp", minval=0.0, step=1.0, group="Scalp Engine", tooltip="Ensures minimum baseline momentum before taking a pullback scalp.")
minAtrRatioScalp     = input.float(0.60, title="Min ATR Ratio for Scalp", step=0.05, group="Scalp Engine")
maxAtrRatioScalp     = input.float(1.80, title="Max ATR Ratio for Scalp", step=0.05, group="Scalp Engine")

// --- NEW: Key Levels (HTF Support/Resistance) ---
showKeyLevels     = input.bool(true,  title="Show Key Levels (Hourly + Daily S/R)", group="Key Levels")
hourlyLookback    = input.int(30, title="Hourly Swing Lookback (bars)", minval=2, group="Key Levels", tooltip="Number of completed hourly bars scanned for the swing high/low, e.g. 30 ≈ last week for an index that trades ~6 hourly bars/day. Larger = more significant but older levels; smaller = more reactive to just today/yesterday.")
levelProximityATR = input.float(0.5,  title="Near-Level Threshold (x ATR, feeds Quality)", step=0.1, group="Key Levels")
dailyLevelColor   = input.color(color.new(color.fuchsia, 10), title="Daily Level Color",  group="Key Levels")
hourlyLevelColor  = input.color(color.new(#00BCD4, 10),        title="Hourly Level Color", group="Key Levels")

// --- EMA ---
emaHigh = ta.ema(close, emaLength)
emaLow  = ta.ema(low,   emaLength)


// --- Delta Zone Inputs ---
showDeltaZones = input(true,  title="Show Delta Zones")
stddevlevel    = input.float(3.5, title="Delta Std Dev",             step=0.5)
stddevlookback = input.int(20,    title="Delta Std Dev Lookback")
buyBoxColor    = input.color(color.new(color.green, 83), title="Buy Box Color")
sellBoxColor   = input.color(color.new(color.red,   83), title="Sell Box Color")
showBuyBoxes   = input.bool(true,  title="Show Buy Boxes")
showSellBoxes  = input.bool(true,  title="Show Sell Boxes")

// --- RSI ---
rsiValue = ta.rsi(close, rsiLength)

// --- ADX / DI ---
getADXDI(length) =>
    trueRange  = ta.tr(true)
    changeHigh = ta.change(high)
    changeLow  = -ta.change(low)
    plusDM  = na(changeHigh) ? na : (changeHigh > changeLow and changeHigh > 0 ? changeHigh : 0)
    minusDM = na(changeLow)  ? na : (changeLow > changeHigh and changeLow  > 0 ? changeLow  : 0)
    atr     = ta.rma(trueRange, length)
    plusDI  = 100 * ta.rma(plusDM,  length) / atr
    minusDI = 100 * ta.rma(minusDM, length) / atr
    dx      = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
    adxValue = ta.rma(dx, length)
    [adxValue, plusDI, minusDI]

[adxVal, plusDiVal, minusDiVal] = getADXDI(adxLength)

// ================== NEW: HTF ALIGNMENT (15-min) ==================
htfEMA = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, emaLength), lookahead=barmerge.lookahead_off)
[htfADX, htfPlusDI, htfMinusDI] = request.security(syminfo.tickerid, htfTimeframe, getADXDI(adxLength), lookahead=barmerge.lookahead_off)
htfClose = request.security(syminfo.tickerid, htfTimeframe, close, lookahead=barmerge.lookahead_off)

htfBullish = htfClose > htfEMA and htfPlusDI > htfMinusDI
htfBearish = htfClose < htfEMA and htfMinusDI > htfPlusDI

//=========================EMA BAND Green Red=========================
// --- EMA 9 / EMA 21 Ribbon ---

emaRibbonGroup = "EMA 9/21 Ribbon"

// ================== DASHBOARD SETTINGS ==================
dashboardGroup = "Dashboard"

dashboardTextSize = input.string("Medium", "Dashboard Text Size", options=["Compact", "Medium", "Large"],group=dashboardGroup)

showEMARibbon = input.bool(true, "Show EMA 9/21 Ribbon", group=emaRibbonGroup)
dashboardSize =
     dashboardTextSize == "Compact" ? size.tiny :
     dashboardTextSize == "Medium"  ? size.small :
     size.normal

emaRibbonOpacity = input.int(80,"EMA Ribbon Opacity",minval=0,maxval=100,group=emaRibbonGroup)
ema9  = ta.ema(close, 9)
ema21 = ta.ema(close, 21)

// EMA 9 = Green
pEMA9 = plot(showEMARibbon ? ema9 : na, color=color.green, linewidth=2,title="EMA 9")

// EMA 21 = Red
pEMA21 = plot(showEMARibbon ? ema21 : na, color=color.red, linewidth=2,title="EMA 21")

// Green when EMA 9 is above EMA 21
// Red when EMA 9 is below EMA 21
emaRibbonColor = ema9 > ema21 ? color.green : color.red

fill(pEMA9,pEMA21, color=showEMARibbon ? color.new(emaRibbonColor, emaRibbonOpacity) : na,title="EMA 9/21 Ribbon")

// ===================================================================

// --- Trend Score ---
//V1
// rsiComponent = rsiValue / 100

// diComponent = math.max(plusDiVal - minusDiVal, 0) / 40

// adxComponent = adxVal / 50

// blrComponent = close > ta.ema(low, 21) ? 0.25 : 0.0

// momentumComponent = math.max(rsiValue - rsiValue[1], 0) / 20

// trendScoreRaw =
//      (rsiComponent * 1.0) +
//      (diComponent * 0.9) +
//      (adxComponent * 0.7) +
//      blrComponent +
//      momentumComponent

// trendScore = math.round(trendScoreRaw * 10) / 10

// ===== Trend Score v2 =====

// RSI Strength
rsiScore =
     rsiValue >= 65 ? 1.0 :
     rsiValue >= 55 ? 0.7 :
     rsiValue >= 50 ? 0.4 : 0.0

// ADX Strength
adxScore =
     adxVal >= 30 ? 1.0 :
     adxVal >= 20 ? 0.6 :
     adxVal >= 15 ? 0.3 : 0.0

// DI Dominance
diSpread = plusDiVal - minusDiVal

diScore =
     math.max(math.min(diSpread, 30), 0) / 30

// EMA Trend
emaScore = close > emaHigh ? 1.0 : 0.0

trendScoreRaw =
     rsiScore +
     adxScore +
     diScore +
     emaScore

trendScore = math.round(trendScoreRaw * 10) / 10

// ======================
// SHORT TREND SCORE
// ======================

bearDiSpread = minusDiVal - plusDiVal

shortDiScore =
     math.max(math.min(bearDiSpread, 30), 0) / 30

shortEmaScore =
     close < emaLow ? 1.0 : 0.0

shortRsiScore =
     rsiValue <= 35 ? 1.0 :
     rsiValue <= 45 ? 0.7 :
     rsiValue <= 50 ? 0.4 : 0.0

shortTrendScore =
     shortRsiScore +
     adxScore +
     shortDiScore +
     shortEmaScore

shortTrendScore :=
     math.round(shortTrendScore * 10) / 10

// ================== NEW: ADX SLOPE + DI SPREAD EXPANSION ==================
adxSlopeUp = adxVal > adxVal[adxSlopeBars]

diSpreadExpandingUp   = diSpread > diSpread[adxSlopeBars]
diSpreadExpandingDown = bearDiSpread > bearDiSpread[adxSlopeBars]
// ============================================================================

// --- ATR Length ---
atrLength = timeframe.period == "5"  ? 14 :timeframe.period == "15" ? 10 :timeframe.period == "30" ? 9  :timeframe.period == "45" ? 8  :timeframe.period == "60" ? 7  : 14

// --- Momentum ---
momentumCategory(adx, plusDI, minusDI) =>
    if adx < 20
        "Weak"
    else if adx >= 20 and adx < 25
        plusDI > minusDI ? "Trend Init(SOR-L)" : "Trend Init(SOR-S)"
    else if adx >= 25
        plusDI > minusDI ? "Strong(L)" : "Strong(S)"
    else
        "Undefined"

momentum = momentumCategory(adxVal, plusDiVal, minusDiVal)

// --- Market Type ---
marketType = "Sideways"
if adxVal > 25 and plusDiVal > minusDiVal and rsiValue > 60
    marketType := "Strong Bullish"
else if adxVal < 25 and plusDiVal > minusDiVal and rsiValue > 50
    marketType := "Weak Bullish"
else if adxVal > 25 and minusDiVal > plusDiVal and rsiValue < 40
    marketType := "Strong Bearish"
else if adxVal < 25 and minusDiVal > plusDiVal and rsiValue < 50
    marketType := "Weak Bearish"
else if adxVal < 20
    marketType := "Sideways"

// --- Signal State (declared early for table use) ---
var bool scoutLongActive  = false
var bool scoutShortActive = false
var bool longConfirmed    = false
var bool shortConfirmed   = false
var int  lastLongBar      = 0
var int  lastShortBar     = 0
var bool longLabelCreated  = false    
var bool shortLabelCreated = false    
var int  dailyScalpCount   = 0

// --- NEW: Trade Quality State ---
var string tradeQuality = "N/A"

// --- Active Trade Management ---
var float tradeEntry = na
var float activeSL = na

var int tradeDirection = 0
// 1 = BUY
// -1 = SELL

var float tp1 = na
var float tp2 = na
var float tp3 = na
var float tp4 = na
var float tp5 = na

var string nextTargetText = "N/A"
var string activeTradeText = "NONE"
var line slLine  = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na
var line tp4Line = na
var line tp5Line = na

var label tp1Label = na
var label tp2Label = na
var label tp3Label = na
var label tp4Label = na
var label tp5Label = na
var label slLabel  = na

atrValue = ta.atr(atrLength)
// --- ATR Study ---
atrAvg20 = ta.sma(atrValue, 20)
atrRatio = atrAvg20 != 0 ? atrValue / atrAvg20 : na
atrChangePct = atrValue[1] != 0 ? ((atrValue - atrValue[1]) / atrValue[1]) * 100 : na

atrRising = atrValue > atrValue[1]
atrTrendText = atrRising ? "↑ Rising" : "↓ Falling"

// ================== NEW: KEY LEVELS (HTF Support/Resistance) ==================
// Previous completed Daily and Hourly high/low, fetched with the [1] offset +
// lookahead_on so we only ever reference a fully closed HTF bar (no repaint).
prevDayHigh  = request.security(syminfo.tickerid, "D",  high[1], lookahead=barmerge.lookahead_on)
prevDayLow   = request.security(syminfo.tickerid, "D",  low[1],  lookahead=barmerge.lookahead_on)
prevHourHigh = request.security(syminfo.tickerid, "60", ta.highest(high, hourlyLookback)[1], lookahead=barmerge.lookahead_on)
prevHourLow  = request.security(syminfo.tickerid, "60", ta.lowest(low, hourlyLookback)[1],   lookahead=barmerge.lookahead_on)

// Always computed (not gated by a toggle) — feeds the existing TREND/SCALP Quality
// classification below rather than hard-blocking a signal on its own.
nearResistance = (not na(prevDayHigh)  and math.abs(close - prevDayHigh)  <= levelProximityATR * atrValue) or
     (not na(prevHourHigh) and math.abs(close - prevHourHigh) <= levelProximityATR * atrValue)

nearSupport = (not na(prevDayLow)  and math.abs(close - prevDayLow)  <= levelProximityATR * atrValue) or
     (not na(prevHourLow) and math.abs(close - prevHourLow) <= levelProximityATR * atrValue)

keyLevelStatusText = nearResistance ? "⚠ Near Res" : nearSupport ? "⚠ Near Sup" : "Clear"
// ================================================================================

// EMA cross conditions (with ADX filter to avoid weak market false triggers)
crossAboveEMA  = ta.crossover(close,  emaHigh) and adxVal >= 20
crossBelowEMA  = ta.crossunder(close, emaLow)  and adxVal >= 20
priceAboveEMAH = close > emaHigh
priceBelowEMAL = close < emaLow
adxIncreasing  = adxVal > nz(adxVal[1], 0)
nBarHigh    = ta.highest(high, breakoutLookback)[1]
nBarLow     = ta.lowest(low, breakoutLookback)[1]
avgVolume   = ta.sma(volume, volumeLookback)
volumeSpike = volume > avgVolume * volumeMultiplier

/// ===== BLR Ribbon =====

// Inputs
showBLR   = input.bool(true, "Plot BLR Moving Average")
blrColor  = input.color(color.green, "BLR Color")
blrShading = input.int(65, "BLR Shading", minval=0, maxval=100)

// BLR Logic
length = 21

upper = ta.ema(ta.ema(close, 21), 2)
lower = ta.ema(low, 21)

emaMid = (upper + lower) / 2

// Plots
plot(showBLR ? emaMid : na, color=color.blue, title="Midline", display=display.none)

p1 = plot(showBLR ? upper : na, color=blrColor, title="Upper Band", display=display.none)

p2 = plot(showBLR ? lower : na, color=blrColor, title="Lower Band", display=display.none)

fill(p1, p2, color=color.new(blrColor, blrShading))

// --- Weekly VWAP ---
newSessionW = ta.change(time("W"))
newSessionD = ta.change(time("D"))
newSessionH = ta.change(time("60"))

getVWAP(newSession) =>
    var float p   = na
    var float vol = na
    var float Sn  = na
    var float v   = na
    var float std = na
    p   := newSession ? hlc3*volume : (na(p)   ? hlc3*volume : p+hlc3*volume)
    vol := newSession ? volume      : (na(vol)  ? volume      : vol+volume)
    v   := p / vol
    Sn  := newSession ? 0 : (na(Sn) ? 0 : Sn + volume*(hlc3-v[1])*(hlc3-v))
    std := math.sqrt(Sn / vol)
    [v, std]

getVWAPDaily(newSession) =>
    var float p2   = na
    var float vol2 = na
    var float Sn2  = na
    var float v2   = na
    var float std2 = na
    p2   := newSession ? hlc3*volume : (na(p2)   ? hlc3*volume : p2+hlc3*volume)
    vol2 := newSession ? volume      : (na(vol2)  ? volume      : vol2+volume)
    v2   := p2 / vol2
    Sn2  := newSession ? 0 : (na(Sn2) ? 0 : Sn2 + volume*(hlc3-v2[1])*(hlc3-v2))
    std2 := math.sqrt(Sn2 / vol2)
    [v2, std2]

[vW, stdevW] = getVWAP(newSessionW)
[vD, stdevD] = getVWAPDaily(newSessionD)

vwPlot = showWeeklyVWAP ? vW : na
plot(vwPlot, title="VWAP - Weekly", color=color.blue, linewidth=2, style=plot.style_line)

prevVWAP     = ta.valuewhen(newSessionW, vW[1], 0)
prevVWAPPlot = showPrev ? prevVWAP : na
plot(prevVWAPPlot, title="Previous VWAP - Weekly", color=#40E20099, style=plot.style_cross, linewidth=2)

prevVWAPS1Up = showPrevBand ? prevVWAP + std1*stdevW[1] : na
prevVWAPS1Dn = showPrevBand ? prevVWAP - std1*stdevW[1] : na
plot(prevVWAPS1Up, title="Previous VWAP S1 - Weekly (Up)",   color=#40E20099, style=plot.style_line, linewidth=1)
plot(prevVWAPS1Dn, title="Previous VWAP S1 - Weekly (Down)", color=#40E20099, style=plot.style_line, linewidth=1)

// --- Daily VWAP Value Zone ---
bool  showDailyVWAP  = input.bool(true,  "Show Daily VWAP")
color dailyVWAPColor = input.color(color.yellow, "Daily VWAP Color")
bool  showValueZone  = input.bool(true,  "Show Value Zone")
color valueZoneColor = input.color(color.new(color.blue, 85), "Value Zone Fill")
float zoneMultiplier = input.float(0.2,  "Zone Multiplier", step=0.1)

float dailyVWAP = ta.vwap(hlc3)
plot(showDailyVWAP ? dailyVWAP : na, title="Daily VWAP", color=dailyVWAPColor, linewidth=2)

prevDayRange = prevDayHigh - prevDayLow

dailyOpenLocal = request.security(syminfo.tickerid, "D", open, lookahead=barmerge.lookahead_on)
adjustedChangeLocal =
     str.contains(syminfo.ticker, "BANK")  ? 0.0017 :
     str.contains(syminfo.ticker, "NIFTY") ? 0.0025 :
     dailyOpenLocal < 100   ? 0.0200 :
     dailyOpenLocal < 500   ? 0.0150 :
     dailyOpenLocal < 1000  ? 0.0120 :
     dailyOpenLocal < 2000  ? 0.0100 :
     dailyOpenLocal < 5000  ? 0.0100 :
     dailyOpenLocal < 15000 ? 0.0036 : 0.0025

bzLocal       = dailyOpenLocal * (1 - adjustedChangeLocal)
valueZoneHigh = showValueZone ? bzLocal : na
valueZoneLow  = showValueZone ? bzLocal - (prevDayRange * zoneMultiplier) : na

pZoneUp = plot(valueZoneHigh, color=color.new(color.blue,100), title="Value Zone Upper")
pZoneDn = plot(valueZoneLow,  color=color.new(color.blue,100), title="Value Zone Lower")
fill(pZoneUp, pZoneDn, color=valueZoneColor, title="Value Zone Fill")

// --- Breakout Zones ---
dailyOpen = request.security(syminfo.tickerid, "D", open, lookahead=barmerge.lookahead_on)
dayHigh   = request.security(syminfo.tickerid, "D", high, lookahead=barmerge.lookahead_on)
dayLow    = request.security(syminfo.tickerid, "D", low,  lookahead=barmerge.lookahead_on)

k    = str.contains(syminfo.ticker, "BANK")  ? 0.10 :
       str.contains(syminfo.ticker, "NIFTY") ? 0.25 :
       str.contains(syminfo.prefix, "MCX")   ? 0.05 : 0.10
bpoc = dailyOpen + k * (dayHigh - dayLow)

adjustedChange =
     str.contains(syminfo.ticker, "BANK")  ? 0.0017 :
     str.contains(syminfo.ticker, "NIFTY") ? 0.0025 :
     str.contains(syminfo.prefix, "MCX")   ? 0.0040 :
     str.contains(syminfo.ticker, "SENSEX") ? 0.0015 :
     dailyOpen < 100   ? 0.0200 :
     dailyOpen < 500   ? 0.0150 :
     dailyOpen < 1000  ? 0.0120 :
     dailyOpen < 2000  ? 0.0100 :
     dailyOpen < 5000  ? 0.0100 :
     dailyOpen < 15000 ? 0.0036 : 0.0025

bbz     = dailyOpen * (1 + adjustedChange)
bz      = dailyOpen * (1 - adjustedChange)
midLine = (bbz + bz) / 2

// --- Signal Setup Conditions ---
longSetup =
     priceAboveEMAH and
     plusDiVal > minusDiVal and
     rsiValue > 55  and
     (adxVal >= 20 or adxIncreasing) and
     trendScore >= 2.5 and
     close > bbz and
     //close > high[1]
     close > nBarHigh
     

shortSetup =
     priceBelowEMAL and
     minusDiVal > plusDiVal and
     rsiValue < 45  and
     (adxVal >= 20 or adxIncreasing) and
     shortTrendScore >= 2.5 and
     close < bz and
     //close < low[1]
     close < nBarLow

confirmedLongCondition =
     longSetup and
     close > emaHigh

confirmedShortCondition =
     shortSetup and
     close < emaLow

// ================== DASHBOARD SCORE ==================

float bullScore = 0.0
float bearScore = 0.0

// VWAP
bullScore += close > vD ? 1 : 0
bearScore += close < vD ? 1 : 0

// RSI
bullScore += rsiValue > 50 ? 1 : 0
bearScore += rsiValue < 50 ? 1 : 0

// DI
bullScore += plusDiVal > minusDiVal ? 1 : 0
bearScore += minusDiVal > plusDiVal ? 1 : 0

// EMA 9 / EMA 21
bullScore += ema9 > ema21 ? 1 : 0
bearScore += ema9 < ema21 ? 1 : 0

// ADX
bullScore += adxVal >= 25 ? 1 : 0
bearScore += adxVal >= 25 ? 1 : 0

// Volume
bullScore += volumeSpike ? 1 : 0
bearScore += volumeSpike ? 1 : 0

// Candle direction
bullScore += close > open ? 1 : 0
bearScore += close < open ? 1 : 0

bullPct = bullScore / 7.0 * 100.0
bearPct = bearScore / 7.0 * 100.0

// Market Bias
marketBias =
     bullPct >= 70 ? "STRONG BULL" :
     bearPct >= 70 ? "STRONG BEAR" :
     bullPct > bearPct ? "BULL" :
     bearPct > bullPct ? "BEAR" :
     "NEUTRAL"

marketBiasColor =
     marketBias == "STRONG BULL" ? color.green :
     marketBias == "STRONG BEAR" ? color.red :
     marketBias == "BULL" ? color.green :
     marketBias == "BEAR" ? color.red :
     color.gray

// ================== DASHBOARD TABLE ==================

var table tableInfo = na

if na(tableInfo)
    tablePosition = switch panelPosition
        "top_left"      => position.top_left
        "top_center"    => position.top_center
        "top_right"     => position.top_right
        "bottom_left"   => position.bottom_left
        "bottom_center" => position.bottom_center
        "bottom_right"  => position.bottom_right
        "center_left"   => position.middle_left
        =>                 position.top_right

    tableInfo := table.new(tablePosition, 2, 17)


// ================== DASHBOARD COLORS ==================

dashGreenStrong = color.rgb(76, 175, 80)
dashRedStrong   = color.rgb(244, 67, 54)
dashYellow      = color.rgb(255, 248, 210)
dashGray        = color.rgb(235, 235, 235)


// ================== OVERALL DIRECTIONAL CONTEXT ==================

// Direction is determined from EMA 9/21 + DI.
// ADX and ATR do not determine direction by themselves.

bullContext = ema9 > ema21 and plusDiVal > minusDiVal
bearContext = ema9 < ema21 and minusDiVal > plusDiVal


// ================================================================
// RSI
// ================================================================

color rsiCellColor = dashYellow

if rsiValue >= 55
    rsiCellColor := dashGreenStrong
else if rsiValue <= 45
    rsiCellColor := dashRedStrong


// ================================================================
// ADX
// ================================================================

// ADX tells us trend strength, not direction.
// Therefore direction comes from bullContext / bearContext.

adxRising = adxVal > nz(adxVal[1], adxVal)

color adxCellColor = dashYellow

if adxRising and bullContext
    adxCellColor := dashGreenStrong
else if adxRising and bearContext
    adxCellColor := dashRedStrong


// ================================================================
// EMA CROSS
// ================================================================

color emaCellColor = dashYellow

if ema9 > ema21
    emaCellColor := dashGreenStrong
else if ema9 < ema21
    emaCellColor := dashRedStrong


// ================================================================
// PRICE / VWAP
// ================================================================

color priceVWAPCellColor = dashYellow

if close > vD
    priceVWAPCellColor := dashGreenStrong
else if close < vD
    priceVWAPCellColor := dashRedStrong


// ================================================================
// ATR
// ================================================================

// ATR is volatility, not direction.
// Expansion gets the color of the current direction.

atrExpanding = atrValue > nz(atrValue[1], atrValue)

color atrCellColor = dashYellow

if atrExpanding and atrRatio >= 1.0 and bullContext
    atrCellColor := dashGreenStrong
else if atrExpanding and atrRatio >= 1.0 and bearContext
    atrCellColor := dashRedStrong


// ================================================================
// ATR RATIO
// ================================================================

color atrRatioCellColor = dashYellow

if atrRatio >= 1.0 and bullContext
    atrRatioCellColor := dashGreenStrong
else if atrRatio >= 1.0 and bearContext
    atrRatioCellColor := dashRedStrong


// ================================================================
// ATR CHANGE
// ================================================================

color atrChangeCellColor = dashYellow

if atrChangePct >= 2.0 and bullContext
    atrChangeCellColor := dashGreenStrong
else if atrChangePct >= 2.0 and bearContext
    atrChangeCellColor := dashRedStrong


// ================================================================
// ATR TREND
// ================================================================

color atrTrendCellColor = dashYellow

if atrRising and bullContext
    atrTrendCellColor := dashGreenStrong
else if atrRising and bearContext
    atrTrendCellColor := dashRedStrong


// ================================================================
// VOLUME
// ================================================================

color volCellColor = dashYellow

if volumeSpike and bullContext
    volCellColor := dashGreenStrong
else if volumeSpike and bearContext
    volCellColor := dashRedStrong


// ================================================================
// TREND STRENGTH
// ================================================================

trendStrengthText =
     adxVal >= 25 ? "STRONG" :
     adxVal >= 20 ? "MODERATE" :
     "WEAK"

color trendStrengthCellColor = dashYellow

if adxRising and adxVal >= 25 and bullContext
    trendStrengthCellColor := dashGreenStrong
else if adxRising and adxVal >= 25 and bearContext
    trendStrengthCellColor := dashRedStrong


// ================================================================
// STATUS
// ================================================================

// Use the ACTUAL variables present in your script.

string dashboardStatus = "WAIT"
color statusCellColor = dashYellow

if confirmedLongCondition
    dashboardStatus := "BUY"
    statusCellColor := dashGreenStrong
else if confirmedShortCondition
    dashboardStatus := "SELL"
    statusCellColor := dashRedStrong


// ================================================================
// MARKET BIAS COLOR
// ================================================================

color marketBiasCellColor = dashYellow

if marketBias == "STRONG BULL"
    marketBiasCellColor := dashGreenStrong
else if marketBias == "STRONG BEAR"
    marketBiasCellColor := dashRedStrong
else if marketBias == "BULL"
    marketBiasCellColor := dashGreenStrong
else if marketBias == "BEAR"
    marketBiasCellColor := dashRedStrong


// ================== DASHBOARD CELL FUNCTION ==================

cell(col, row, txt, bgcolor) =>
    table.cell(
         tableInfo,
         col,
         row,
         txt,
         bgcolor=bgcolor,
         text_color=color.black,
         text_size=dashboardSize)


// ================== DASHBOARD ROWS ==================


// ================================================================
// 1. BULL SCORE
// ================================================================

cell(0, 1, "BULL SCORE", dashGreenStrong)
cell(1, 1, str.tostring(bullPct, "#") + "%", dashGreenStrong)


// ================================================================
// 2. BEAR SCORE
// ================================================================

cell(0, 2, "BEAR SCORE", dashRedStrong)
cell(1, 2, str.tostring(bearPct, "#") + "%", dashRedStrong)


// ================================================================
// 3. MARKET BIAS
// ================================================================

cell(0, 3, "MARKET BIAS", dashYellow)
cell(1, 3, marketBias, marketBiasCellColor)


// ================================================================
// 4. PRICE / VWAP
// ================================================================

cell(0, 4, "Price/VWAP", dashYellow)

if close > vD
    cell(1, 4, "ABOVE", priceVWAPCellColor)
else
    cell(1, 4, "BELOW", priceVWAPCellColor)


// ================================================================
// 5. RSI
// ================================================================

cell(0, 5, "RSI", dashYellow)
cell(1, 5, str.tostring(rsiValue, "#.#"), rsiCellColor)


// ================================================================
// 6. ADX
// ================================================================

cell(0, 6, "ADX", dashYellow)
cell(1, 6, str.tostring(adxVal, "#.#"), adxCellColor)


// ================================================================
// 7. EMA CROSS
// ================================================================

cell(0, 7, "EMA Cross", dashYellow)

if ema9 > ema21
    cell(1, 7, "BULL", emaCellColor)
else
    cell(1, 7, "BEAR", emaCellColor)


// ================================================================
// 8. ATR
// ================================================================

cell(0, 8, "ATR", dashYellow)
cell(1, 8, str.tostring(atrValue, "#.##"), atrCellColor)


// ================================================================
// 9. ATR RATIO
// ================================================================

cell(0, 9, "ATR Ratio", dashYellow)
cell(1, 9, str.tostring(atrRatio, "#.##"), atrRatioCellColor)


// ================================================================
// 10. ATR CHANGE
// ================================================================

cell(0, 10, "ATR Change", dashYellow)
cell(1, 10, str.tostring(atrChangePct, "#.##") + "%", atrChangeCellColor)


// ================================================================
// 11. ATR TREND
// ================================================================

cell(0, 11, "ATR Trend", dashYellow)
cell(1, 11, atrTrendText, atrTrendCellColor)


// ================================================================
// 12. VOLUME
// ================================================================

cell(0, 12, "Vol Status", dashYellow)
cell(1, 12, volumeSpike ? "HIGH" : "NORMAL", volCellColor)


// ================================================================
// 13. TREND STRENGTH
// ================================================================

cell(0, 13, "Trend Str", dashYellow)
cell(1, 13, trendStrengthText, trendStrengthCellColor)


// ================================================================
// 14. STATUS
// ================================================================

cell(0, 14, "Status", dashYellow)
cell(1, 14, dashboardStatus, statusCellColor)


// --- NEW: Setup 1a (21-EMA Pullback-Continuation Scalp Conditions) ---
candleRange = math.max(high - low, syminfo.mintick)
longWick    = (close - low) / candleRange
shortWick   = (high - close) / candleRange

touchLowerEma = low <= lower and close > lower
touchUpperEma = high >= upper and close < upper

atrRatioValid = not na(atrRatio) and atrRatio >= minAtrRatioScalp and atrRatio <= maxAtrRatioScalp
adxScalpValid = adxVal >= minAdxScalp

// Strict DI dominance and minimum spread gap (filters narrow / tangled chop)
diBullishScalp = plusDiVal > minusDiVal and diSpread >= minDiSpreadScalp and diSpreadExpandingUp
diBearishScalp = minusDiVal > plusDiVal and bearDiSpread >= minDiSpreadScalp and diSpreadExpandingDown

scalpPullbackLongCondition = enablePullbackScalps and touchLowerEma and (longWick >= rejectionWickPct) and diBullishScalp and adxScalpValid and (close > close[1]) and atrRatioValid and (not nearResistance) and (not useVWAPFilter or close > dailyVWAP) and (dailyScalpCount < maxDailyScalps)

scalpPullbackShortCondition = enablePullbackScalps and touchUpperEma and (shortWick >= rejectionWickPct) and diBearishScalp and adxScalpValid and (close < close[1]) and atrRatioValid and (not nearSupport) and (not useVWAPFilter or close < dailyVWAP) and (dailyScalpCount < maxDailyScalps)

// --- Rearm Conditions ---
// bool longRearmCondition =
//      (trendScore < 1.0 and trendScore[1] < 1.0) or
//      (minusDiVal > plusDiVal and adxVal > 20 and minusDiVal[1] > plusDiVal[1])

// bool shortRearmCondition =
//      (trendScore > 2.5 and trendScore[1] > 2.5) or
//      (plusDiVal > minusDiVal and adxVal > 20 and plusDiVal[1] > minusDiVal[1])

bool longRearmCondition =
     (rsiValue < 50 and close < emaHigh) 
     

bool shortRearmCondition =
     (rsiValue > 50 and close > emaLow) 

deleteTradeLines() =>
    if not na(tp1Label)
        label.delete(tp1Label)

    if not na(tp2Label)
        label.delete(tp2Label)

    if not na(tp3Label)
        label.delete(tp3Label)

    if not na(tp4Label)
        label.delete(tp4Label)

    if not na(tp5Label)
        label.delete(tp5Label)

    if not na(slLabel)
        label.delete(slLabel)

    if not na(slLine)
        line.delete(slLine)

    if not na(tp1Line)
        line.delete(tp1Line)

    if not na(tp2Line)
        line.delete(tp2Line)

    if not na(tp3Line)
        line.delete(tp3Line)

    if not na(tp4Line)
        line.delete(tp4Line)

    if not na(tp5Line)
        line.delete(tp5Line)
   

// --- Day Reset ---
if ta.change(time("D"))
    lastLongBar       := 0
    lastShortBar      := 0
    scoutLongActive   := false
    scoutShortActive  := false
    longConfirmed     := false
    shortConfirmed    := false
    longLabelCreated  := false    // ← ADD
    shortLabelCreated := false    // ← ADD
    dailyScalpCount   := 0
    deleteTradeLines()

    tradeDirection := 0
    tradeEntry := na
    activeSL := na

    tp1 := na
    tp2 := na
    tp3 := na
    tp4 := na
    tp5 := na

    activeTradeText := "NONE"
    nextTargetText := "N/A"
    tradeQuality := "N/A"

// --- Rearm (only when setup NOT active) ---
if longRearmCondition and not longSetup
    scoutLongActive := false
    longConfirmed   := false

if shortRearmCondition and not shortSetup
    scoutShortActive := false
    shortConfirmed   := false

// --- Scout & Confirm Logic ---
scoutingLong  = false
scoutingShort = false
confirmedLong  = false
confirmedShort = false
confirmedPullbackLong  = false
confirmedPullbackShort = false

if longSetup and not scoutLongActive and not longConfirmed
    scoutingLong    := true
    scoutLongActive := true

if shortSetup and not scoutShortActive and not shortConfirmed
    scoutingShort    := true
    scoutShortActive := true

// Confirm only on bar CLOSE (barstate.isconfirmed)
if barstate.isconfirmed and confirmedLongCondition and scoutLongActive and not longConfirmed and (bar_index - lastLongBar >= minBarsCooldown)
    confirmedLong  := true
    longConfirmed  := true
    lastLongBar    := bar_index

if barstate.isconfirmed and confirmedShortCondition and scoutShortActive and not shortConfirmed and (bar_index - lastShortBar >= minBarsCooldown)
    confirmedShort  := true
    shortConfirmed  := true
    lastShortBar    := bar_index

// Setup 1a: 21-EMA Pullback Scalp Confirmation
if barstate.isconfirmed and scalpPullbackLongCondition and not longConfirmed and not confirmedLong and (bar_index - lastLongBar >= minBarsCooldown)
    confirmedPullbackLong := true
    longConfirmed         := true
    lastLongBar           := bar_index
    dailyScalpCount       := dailyScalpCount + 1

if barstate.isconfirmed and scalpPullbackShortCondition and not shortConfirmed and not confirmedShort and (bar_index - lastShortBar >= minBarsCooldown)
    confirmedPullbackShort := true
    shortConfirmed         := true
    lastShortBar           := bar_index
    dailyScalpCount        := dailyScalpCount + 1

// --- Scout & Confirmed Labels ---
var scoutLongLabel  = label(na)
var scoutShortLabel = label(na)
var int scoutLongBar  = na
var int scoutShortBar = na

// Create scout label ONCE when scouting first triggers
if scoutingLong and not longLabelCreated
    label.delete(scoutLongLabel)
    scoutLongBar     := bar_index
    longLabelCreated := true
    scoutLongLabel   := label.new(x=bar_index, y=low, text="❄ BUY?",
         yloc=yloc.belowbar, color=color.new(#2196F3, 20),
         textcolor=color.white, style=label.style_label_up, size=size.small)

if scoutingShort and not shortLabelCreated
    label.delete(scoutShortLabel)
    scoutShortBar     := bar_index
    shortLabelCreated := true
    scoutShortLabel   := label.new(x=bar_index, y=high, text="❄ SELL?",
         yloc=yloc.abovebar, color=color.new(#2196F3, 20),
         textcolor=color.white, style=label.style_label_down, size=size.small)

// Reset label flag when rearm happens
if longRearmCondition and not longSetup
    longLabelCreated := false

if shortRearmCondition and not shortSetup
    shortLabelCreated := false

// On confirmation — update color of existing label
if confirmedLong or confirmedPullbackLong
    tradeDirection := 1
    tradeEntry := close
    // Reset previous trade values
    tp1 := na
    tp2 := na
    tp3 := na
    tp4 := na
    tp5 := na

    // Reset old trade state
    nextTargetText := "N/A"

    activeTradeText := "BUY"

    // ================== NEW: TREND vs SCALP CLASSIFICATION ==================
    if confirmedPullbackLong
        tradeQuality := "SCALP"
    else
        qualityLongOK = (not useHTFFilter or htfBullish) and adxSlopeUp and diSpreadExpandingUp and (not useVWAPFilter or close > dailyVWAP) and (not useVolumeFilter or volumeSpike) and not nearResistance
        tradeQuality := qualityLongOK ? "TREND" : "SCALP"
    // ==========================================================================

    tpStep = tradeQuality == "TREND" ? 1.0 : 0.5
    activeSL := tradeEntry - (tradeQuality == "TREND" ? atrValue : atrValue * 0.75)

    tp1 := tradeEntry + atrValue * (tpStep * 1.0)
    tp2 := tradeEntry + atrValue * (tpStep * 2.0)
    tp3 := tradeEntry + atrValue * (tpStep * 3.0)
    tp4 := tradeEntry + atrValue * (tpStep * 4.0)
    tp5 := tradeEntry + atrValue * (tpStep * 5.0)

    deleteTradeLines()

    slLine  := line.new(bar_index, activeSL, bar_index + 75, activeSL, color=color.red, width=2)
    tp1Line := line.new(bar_index, tp1, bar_index + 75, tp1, color=color.blue, style=line.style_dashed)
    tp2Line := line.new(bar_index, tp2, bar_index + 75, tp2, color=color.blue, style=line.style_dashed)
    tp3Line := line.new(bar_index, tp3, bar_index + 75, tp3, color=color.blue, style=line.style_dashed)
    tp4Line := line.new(bar_index, tp4, bar_index + 75, tp4, color=color.green, style=line.style_dashed)
    tp5Line := line.new(bar_index, tp5, bar_index + 75, tp5, color=color.green, style=line.style_dashed)
    tp1Label := label.new(bar_index + 75, tp1, "TP1 (" + str.tostring(tpStep * 1.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(66,133,244), textcolor=color.white, size=size.small)
    tp2Label := label.new(bar_index + 75, tp2, "TP2 (" + str.tostring(tpStep * 2.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(66,133,244), textcolor=color.white, size=size.small)
    tp3Label := label.new(bar_index + 75, tp3, "TP3 (" + str.tostring(tpStep * 3.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(66,133,244), textcolor=color.white, size=size.small)
    tp4Label := label.new(bar_index + 75, tp4, "TP4 (" + str.tostring(tpStep * 4.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(66,133,244), textcolor=color.white, size=size.small)
    tp5Label := label.new(bar_index + 75, tp5, "TP5 (" + str.tostring(tpStep * 5.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(66,133,244), textcolor=color.white, size=size.small)
    slLabel := label.new(bar_index + 75, activeSL, "SL", style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)

    nextTargetText := "TP1 @ " + str.tostring(tp1, "#.##")

    label.delete(scoutLongLabel)
    labelText = confirmedPullbackLong ? "BUY ⚡SCALP (" + str.tostring(dailyScalpCount) + "/" + str.tostring(maxDailyScalps) + ")" : (tradeQuality == "TREND" ? "BUY 🔥T" : "BUY ⚡S")
    labelColor = confirmedPullbackLong ? color.new(#FF9800, 10) : (tradeQuality == "TREND" ? color.new(color.green, 10) : color.new(color.orange, 10))
    label.new(x=bar_index, y=low, text=labelText,
         yloc=yloc.belowbar,
         color=labelColor,
         textcolor=color.white,
         style=label.style_label_up,
         size=size.small)

    longLabelCreated := false

if confirmedShort or confirmedPullbackShort
    tradeDirection := -1
    tradeEntry := close
    // Reset previous trade values
    tp1 := na
    tp2 := na
    tp3 := na
    tp4 := na
    tp5 := na

    // Reset old trade state
    nextTargetText := "N/A"

    activeTradeText := "SELL"

    // ================== NEW: TREND vs SCALP CLASSIFICATION ==================
    if confirmedPullbackShort
        tradeQuality := "SCALP"
    else
        qualityShortOK = (not useHTFFilter or htfBearish) and adxSlopeUp and diSpreadExpandingDown and (not useVWAPFilter or close < dailyVWAP) and (not useVolumeFilter or volumeSpike) and not nearSupport
        tradeQuality := qualityShortOK ? "TREND" : "SCALP"
    // ==========================================================================

    tpStep = tradeQuality == "TREND" ? 1.0 : 0.5
    activeSL := tradeEntry + (tradeQuality == "TREND" ? atrValue : atrValue * 0.75)

    tp1 := tradeEntry - atrValue * (tpStep * 1.0)
    tp2 := tradeEntry - atrValue * (tpStep * 2.0)
    tp3 := tradeEntry - atrValue * (tpStep * 3.0)
    tp4 := tradeEntry - atrValue * (tpStep * 4.0)
    tp5 := tradeEntry - atrValue * (tpStep * 5.0)

    deleteTradeLines()

    slLine  := line.new(bar_index, activeSL, bar_index + 75, activeSL, color=color.red, width=2)

    tp1Line := line.new(bar_index, tp1, bar_index + 75, tp1, color=color.blue, style=line.style_dashed)
    tp2Line := line.new(bar_index, tp2, bar_index + 75, tp2, color=color.blue, style=line.style_dashed)
    tp3Line := line.new(bar_index, tp3, bar_index + 75, tp3, color=color.blue, style=line.style_dashed)
    tp4Line := line.new(bar_index, tp4, bar_index + 75, tp4, color=color.green, style=line.style_dashed)
    tp5Line := line.new(bar_index, tp5, bar_index + 75, tp5, color=color.green, style=line.style_dashed)

    tp1Label := label.new(bar_index + 75, tp1, "TP1 (" + str.tostring(tpStep * 1.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(66,133,244), textcolor=color.white, size=size.small)
    tp2Label := label.new(bar_index + 75, tp2, "TP2 (" + str.tostring(tpStep * 2.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(66,133,244), textcolor=color.white, size=size.small)
    tp3Label := label.new(bar_index + 75, tp3, "TP3 (" + str.tostring(tpStep * 3.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(66,133,244), textcolor=color.white, size=size.small)
    tp4Label := label.new(bar_index + 75, tp4, "TP4 (" + str.tostring(tpStep * 4.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(66,133,244), textcolor=color.white, size=size.small)
    tp5Label := label.new(bar_index + 75, tp5, "TP5 (" + str.tostring(tpStep * 5.0, "#.#") + "x)", style=label.style_label_left, color=color.rgb(76,175,80), textcolor=color.white, size=size.small)

    slLabel := label.new(bar_index + 75, activeSL, "SL", style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)

    nextTargetText := "TP1 @ " + str.tostring(tp1, "#.##")

    label.delete(scoutShortLabel)
    labelText = confirmedPullbackShort ? "SELL ⚡SCALP (" + str.tostring(dailyScalpCount) + "/" + str.tostring(maxDailyScalps) + ")" : (tradeQuality == "TREND" ? "SELL 🔥T" : "SELL ⚡S")
    labelColor = confirmedPullbackShort ? color.new(#FF9800, 10) : (tradeQuality == "TREND" ? color.new(color.red, 10) : color.new(color.orange, 10))
    label.new(x=bar_index, y=high, text=labelText,
         yloc=yloc.abovebar, color=labelColor,
         textcolor=color.white, style=label.style_label_down, size=size.small)

    shortLabelCreated := false

if tradeDirection == 1

    if high >= tp1
        label.set_text(tp1Label, "✓ TP1")
        label.set_color(tp1Label, color.green)
        activeSL := tradeEntry
        nextTargetText := "TP2 @ " + str.tostring(tp2, "#")

    if high >= tp2
        label.set_text(tp2Label, "✓ TP2")
        label.set_color(tp2Label, color.green)
        activeSL := tp1
        nextTargetText := "TP3 @ " + str.tostring(tp3, "#")

    if high >= tp3
        label.set_text(tp3Label, "✓ TP3")
        label.set_color(tp3Label, color.green)
        activeSL := tp2
        nextTargetText := "TP4 @ " + str.tostring(tp4, "#")

    if high >= tp4
        label.set_text(tp4Label, "✓ TP4")
        label.set_color(tp4Label, color.green)
        activeSL := tp3
        nextTargetText := "TP5 @ " + str.tostring(tp5, "#")

    if high >= tp5
        label.set_text(tp5Label, "✓ TP5")
        label.set_color(tp5Label, color.green)
        activeSL := tp4
        nextTargetText := "TARGETS COMPLETE"


// --- SELL Target Progression ---
if tradeDirection == -1

    if low <= tp1
        label.set_text(tp1Label, "✓ TP1")
        label.set_color(tp1Label, color.green)
        activeSL := tradeEntry
        nextTargetText := "TP2 @ " + str.tostring(tp2, "#")

    if low <= tp2
        label.set_text(tp2Label, "✓ TP2")
        label.set_color(tp2Label, color.green)
        activeSL := tp1
        nextTargetText := "TP3 @ " + str.tostring(tp3, "#")

    if low <= tp3
        label.set_text(tp3Label, "✓ TP3")
        label.set_color(tp3Label, color.green)
        activeSL := tp2
        nextTargetText := "TP4 @ " + str.tostring(tp4, "#")

    if low <= tp4
        label.set_text(tp4Label, "✓ TP4")
        label.set_color(tp4Label, color.green)
        activeSL := tp3
        nextTargetText := "TP5 @ " + str.tostring(tp5, "#")

    if low <= tp5
        label.set_text(tp5Label, "✓ TP5")
        label.set_color(tp5Label, color.green)
        activeSL := tp4
        nextTargetText := "TARGETS COMPLETE"




// --- Alerts ---
alertcondition(scoutingLong,           title="Scout Long Alert",         message="❄ GET READY - BUY Scout forming on {{ticker}} at {{close}}")
alertcondition(scoutingShort,          title="Scout Short Alert",        message="❄ GET READY - SELL Scout forming on {{ticker}} at {{close}}")
alertcondition(confirmedLong,          title="Confirmed Long Alert",     message="✅ CONFIRMED BUY on {{ticker}} at {{close}}")
alertcondition(confirmedShort,         title="Confirmed Short Alert",    message="✅ CONFIRMED SELL on {{ticker}} at {{close}}")
alertcondition(confirmedPullbackLong,  title="Pullback Scalp Buy Alert", message="⚡ PULLBACK SCALP BUY on {{ticker}} at {{close}}")
alertcondition(confirmedPullbackShort, title="Pullback Scalp Sell Alert",message="⚡ PULLBACK SCALP SELL on {{ticker}} at {{close}}")
anySignal = scoutingLong or scoutingShort or confirmedLong or confirmedShort or confirmedPullbackLong or confirmedPullbackShort

alertcondition(anySignal, title="Any Signal Alert", message="⚡ Signal fired on {{ticker}} at {{close}} - Check chart!")

// --- Delta Zones ---
var float up_delta   = na
var float down_delta = na
var float delta      = na
var float pos_delta  = na
var float neg_delta  = na
var float wickdevup  = na
var float wickdevdn  = na
var bool  huntingup  = na
var bool  huntingdn  = na
var box   buyBox     = na
var box   sellBox    = na

if showDeltaZones
    uptop = high - close
    upbot = open - low
    dntop = high - open
    dnbot = close - low
    up_delta   := upbot - uptop
    down_delta := dntop - dnbot
    delta      := up_delta != 0 ? up_delta : down_delta != 0 ? down_delta : na
    pos_delta  := delta > 0 ? delta : na
    neg_delta  := delta < 0 ? delta : na
    wickdevup  := ta.stdev(pos_delta, stddevlookback) * stddevlevel
    wickdevdn  := ta.stdev(neg_delta, stddevlookback) * -stddevlevel
    huntingup  := pos_delta >= wickdevup
    huntingdn  := neg_delta <= wickdevdn

    if showBuyBoxes and huntingup
        buyBox := box.new(left=bar_index,
             top=(open <= close ? (open+low)/2 : (close+low)/2),
             right=bar_index, bottom=low,
             bgcolor=buyBoxColor, border_width=1, border_color=color.green)
    else if not na(buyBox)
        box.set_right(buyBox, bar_index + 5)

    if showSellBoxes and huntingdn
        sellBox := box.new(left=bar_index, top=high, right=bar_index,
             bottom=(open < close ? (close+high)/2 : (open+high)/2),
             bgcolor=sellBoxColor, border_width=1, border_color=color.rgb(222,11,11))
    else if not na(sellBox)
        box.set_right(sellBox, bar_index + 5)

// --- SE/BE Labels ---
var seLabel = label(na)
var beLabel = label(na)

if showDeltaZones and huntingup
    label.delete(seLabel)
    seLabel := label.new(x=bar_index, y=low, text="❄ SE",
         yloc=yloc.belowbar, color=color.new(color.teal, 20),
         textcolor=color.white, style=label.style_label_right, size=size.small)

if showDeltaZones and huntingdn
    label.delete(beLabel)
    beLabel := label.new(x=bar_index, y=high, text="❄ BE",
         yloc=yloc.abovebar, color=color.new(color.teal, 20),
         textcolor=color.white, style=label.style_label_right, size=size.small)

alertcondition(showDeltaZones and huntingup, title="Sell Exhaustion Alert", message="❄ SE - Sell Exhaustion on {{ticker}} at {{close}}")
alertcondition(showDeltaZones and huntingdn, title="Buy Exhaustion Alert",  message="❄ BE - Buy Exhaustion on {{ticker}} at {{close}}")

// --- Session Lines ---
sessionStart = timestamp("Asia/Kolkata", year, month, dayofmonth, 9, 15)
sessionEnd   = str.contains(syminfo.prefix, "MCX") ?
     timestamp("Asia/Kolkata", year, month, dayofmonth, 23, 30) :
     timestamp("Asia/Kolkata", year, month, dayofmonth, 15, 30)

var line bbzLine     = na
var line bzLine      = na
var line midLineLine = na
var line bpocLine    = na

if time >= sessionStart and time[1] < sessionStart
    if not na(bbzLine)
        line.delete(bbzLine)
        line.delete(bzLine)
        line.delete(midLineLine)
        line.delete(bpocLine)
    bbzLine     := line.new(sessionStart, bbz,     sessionEnd, bbz,     xloc=xloc.bar_time, color=color.green,  width=4)
    bzLine      := line.new(sessionStart, bz,      sessionEnd, bz,      xloc=xloc.bar_time, color=color.red,    width=4)
    midLineLine := line.new(sessionStart, midLine, sessionEnd, midLine, xloc=xloc.bar_time, color=color.blue,   width=1)
    bpocLine    := line.new(sessionStart, bpoc,    sessionEnd, bpoc,    xloc=xloc.bar_time, color=color.orange, width=2)

// ================== NEW: KEY LEVELS PLOTTING (Hourly + Daily S/R) ==================
// Drawn LAST so these lines render on top of the (thicker) session lines above,
// instead of being hidden underneath them.
var line dailyResLine  = na
var line dailySupLine  = na
var line hourlyResLine = na
var line hourlySupLine = na

if showKeyLevels and newSessionD
    if not na(dailyResLine)
        line.delete(dailyResLine)
        line.delete(dailySupLine)
    dailyResLine := line.new(bar_index - 1, prevDayHigh, bar_index, prevDayHigh, extend=extend.right, color=dailyLevelColor, width=2, style=line.style_dashed)
    dailySupLine := line.new(bar_index - 1, prevDayLow,  bar_index, prevDayLow,  extend=extend.right, color=dailyLevelColor, width=2, style=line.style_dashed)

if showKeyLevels and newSessionH
    if not na(hourlyResLine)
        line.delete(hourlyResLine)
        line.delete(hourlySupLine)
    hourlyResLine := line.new(bar_index - 1, prevHourHigh, bar_index, prevHourHigh, extend=extend.right, color=hourlyLevelColor, width=2, style=line.style_dotted)
    hourlySupLine := line.new(bar_index - 1, prevHourLow,  bar_index, prevHourLow,  extend=extend.right, color=hourlyLevelColor, width=2, style=line.style_dotted)

// --- Sticky tags that hug the current bar, same visual language as TP1-5 ---
var label dailyResTag  = na
var label dailySupTag  = na
var label hourlyResTag = na
var label hourlySupTag = na

if showKeyLevels and not na(prevDayHigh)
    if na(dailyResTag)
        dailyResTag := label.new(bar_index, prevDayHigh, "D-Res", style=label.style_label_left, color=dailyLevelColor, textcolor=color.white, size=size.small)
        dailySupTag := label.new(bar_index, prevDayLow,  "D-Sup", style=label.style_label_left, color=dailyLevelColor, textcolor=color.white, size=size.small)
    else
        label.set_xy(dailyResTag, bar_index, prevDayHigh)
        label.set_xy(dailySupTag, bar_index, prevDayLow)
else if not na(dailyResTag)
    label.delete(dailyResTag)
    label.delete(dailySupTag)
    dailyResTag := na
    dailySupTag := na

if showKeyLevels and not na(prevHourHigh)
    if na(hourlyResTag)
        hourlyResTag := label.new(bar_index, prevHourHigh, "H-Res", style=label.style_label_left, color=hourlyLevelColor, textcolor=color.white, size=size.small)
        hourlySupTag := label.new(bar_index, prevHourLow,  "H-Sup", style=label.style_label_left, color=hourlyLevelColor, textcolor=color.white, size=size.small)
    else
        label.set_xy(hourlyResTag, bar_index, prevHourHigh)
        label.set_xy(hourlySupTag, bar_index, prevHourLow)
else if not na(hourlyResTag)
    label.delete(hourlyResTag)
    label.delete(hourlySupTag)
    hourlyResTag := na
    hourlySupTag := na
// =====================================================================================

// =====================================================================================
// ============ TRADE DECISION ENGINE  -  PASTE AT THE VERY END OF THE SCRIPT ==========
// Reads what your script already computes (signals, ADX/DI, VWAP, HTF, key levels,
// delta-zone exhaustion) and answers: GO / WAIT / SKIP / NO TRADE.
// It does NOT change your original signals. It filters and grades them.
// =====================================================================================
deGroup = "Decision Engine"

dePanelMode    = input.string("Main dashboard rows", "Where to show decision", options=["Main dashboard rows", "Separate panel", "Both", "Off"], group=deGroup, tooltip="'Main dashboard rows' adds DECISION and Veto rows at the bottom of your existing dashboard (needs table.new rows changed to 17). 'Separate panel' shows the full checklist in its own table.")
showMainRows   = dePanelMode == "Main dashboard rows" or dePanelMode == "Both"
showSepPanel   = dePanelMode == "Separate panel" or dePanelMode == "Both"
dePanelPos     = input.string("bottom_right", "Separate Panel Position", options=["top_left","top_center","top_right","bottom_left","bottom_center","bottom_right","center_left"], group=deGroup)
showGoMarkers  = input.bool(true, "Show GO / BLOCKED markers on chart", group=deGroup)
deMinScorePct  = input.float(60, "Min score % for GO", minval=30, maxval=100, step=5, group=deGroup, tooltip="Share of ENABLED score conditions that must pass.")
deAGradePct    = input.float(80, "A-grade score %", minval=50, maxval=100, step=5, group=deGroup)
deTriggerBars  = input.int(2, "Signal stays valid for N bars", minval=0, maxval=10, group=deGroup, tooltip="Signal stays eligible for GO for N bars. 2 allows the candle close confirmation.")

// --- Score conditions (each can be switched off) ---
useCTrend = input.bool(true,  "Score: Trend context (EMA9/21 + DI)", group=deGroup)
useCAdx   = input.bool(true,  "Score: ADX strong and rising",        group=deGroup)
useCVwap  = input.bool(true,  "Score: Price on correct side of VWAP", group=deGroup)
useCRsi   = input.bool(true,  "Score: RSI in healthy zone (not chasing)", group=deGroup)
useCVol   = input.bool(true,  "Score: Recent volume spike",          group=deGroup)
useCHtf   = input.bool(true,  "Score: 15m HTF alignment",            group=deGroup)
useCExh   = input.bool(true,  "Bonus point: supportive exhaustion zone holding (SE for long / BE for short)", group=deGroup)

deMinAdx      = input.float(18, "Min ADX", minval=10, step=1, group=deGroup)
deRsiMax      = input.float(75, "RSI ceiling for longs (shorts use 100 - this)", minval=60, maxval=90, step=1, group=deGroup, tooltip="Blocks chasing. With 75, longs need RSI 50-75 and shorts need RSI 25-50.")
deVolBars     = input.int(4, "Volume spike counts if within N bars", minval=1, maxval=10, group=deGroup)
deExhLookback = input.int(20, "Supportive exhaustion lookback (bars)", minval=3, maxval=60, group=deGroup)

// --- Hard vetoes: any failed veto = SKIP, whatever the score ---
useVetoRoom = input.bool(true,  "Veto: Not enough room to next Daily/Hourly level", group=deGroup)
useVetoExh  = input.bool(true,  "Veto: Opposing exhaustion (BE for long / SE for short)", group=deGroup)
useVetoExt  = input.bool(false, "Veto: Price extended from EMA21 (chasing)", group=deGroup)

deMinRoomATR    = input.float(0.8, "Min room to next level (x ATR)", minval=0.2, step=0.1, group=deGroup, tooltip="Room required before hitting a Daily/Hourly level (0.8 ATR is balanced).")
deVetoBars      = input.int(3, "Opposing exhaustion veto window (bars)", minval=1, maxval=30, group=deGroup)
deMaxExtendATR  = input.float(2.5, "Max distance from EMA21 (x ATR)", minval=0.5, step=0.1, group=deGroup)
deBreakoutExempt = input.bool(true, "Extension veto: allow fresh volume breakouts", group=deGroup, tooltip="If price just broke an N-bar extreme or a Daily/Hourly level (last 3 bars) on recent volume, the distance limit becomes the hard cap below.")
deExtHardCap    = input.float(3.5, "Extension hard cap for breakouts (x ATR)", minval=1.0, step=0.1, group=deGroup)
deExtTrendExempt = input.bool(true, "Extension veto: also allow TREND (🔥T) signals up to the hard cap", group=deGroup, tooltip="A 🔥T signal has already passed your script's own volume, 15m, ADX-slope, DI-expansion, VWAP and key-level checks, so re-checking distance from the EMA21 mostly blocks trend-day continuation.")

// --- Extra strength filters (added) ---
deRequireTrend = input.bool(false, "GO only for TREND (🔥T) signals - scalps can't be GO", group=deGroup)
useCIndex      = input.bool(false, "Score: Index aligned with the trade (not used on MCX)", group=deGroup, tooltip="Turn ON if you specifically want to require Nifty 50 to also be in an EMA uptrend.")
deIdxSym       = input.symbol("NSE:NIFTY", "Index symbol for alignment", group=deGroup, tooltip="Use NSE:BANKNIFTY for Bank Nifty stocks.")
useCClose      = input.bool(true,  "Score: Signal candle closes strong (near its high/low)", group=deGroup)
deCloseStrong  = input.float(0.55, "Strong close = close in the top (long) / bottom (short) share of the range", minval=0.5, maxval=0.95, step=0.05, group=deGroup)
useVetoCost    = input.bool(false, "Veto: TP1 too close to cover costs", group=deGroup)
deMinTP1Pct    = input.float(0.15, "Min TP1 distance (% of price)", minval=0.02, step=0.01, group=deGroup)
useDayLimits   = input.bool(false, "Daily limits: stop new GO after max losses / max trades", group=deGroup)
deMaxLossesDay = input.int(2, "Max losing GO trades per day", minval=1, maxval=10, group=deGroup)
deMaxGoPerDay  = input.int(3, "Max GO trades per day", minval=1, maxval=10, group=deGroup)
useSessionGate = input.bool(false, "Only allow GO inside a time window (IST)", group=deGroup)
deSession      = input.session("0930-1500", "GO time window (IST)", group=deGroup)
useVetoZone    = input.bool(true,  "Veto: Delta zone in the way (BE zone above a long / SE zone below a short)", group=deGroup)
deVwapMust     = input.bool(true,  "Veto: Price on the wrong side of daily VWAP (hard rule)", group=deGroup)

// --- Delta Zone HTF & Source Settings ---
deDeltaTf     = input.timeframe("15", "Delta Zone HTF Timeframe", group=deGroup, tooltip="Timeframe used to detect SE/BE Delta Zones for the Decision Engine.")
deDeltaSource = input.string("Both (15m + Chart)", "Delta Zone Source for DE", options=["15m HTF", "Chart Timeframe", "Both (15m + Chart)"], group=deGroup, tooltip="'15m HTF' evaluates Delta Zones on 15m. 'Chart Timeframe' uses chart TF. 'Both' checks both.")

// ---------- Delta Zones Function (runs on HTF via request.security or Chart) ----------
f_calcDeltaZones(lookback, devLevel) =>
    _uptop = high - close
    _upbot = open - low
    _dntop = high - open
    _dnbot = close - low
    _up_delta   = _upbot - _uptop
    _down_delta = _dntop - _dnbot
    _delta      = _up_delta != 0 ? _up_delta : _down_delta != 0 ? _down_delta : na
    _pos_delta  = _delta > 0 ? _delta : na
    _neg_delta  = _delta < 0 ? _delta : na
    _wickdevup  = ta.stdev(_pos_delta, lookback) * devLevel
    _wickdevdn  = ta.stdev(_neg_delta, lookback) * -devLevel
    _hUp        = _pos_delta >= _wickdevup
    _hDn        = _neg_delta <= _wickdevdn
    _seLow      = low
    _seHigh     = (open <= close ? (open + low) / 2.0 : (close + low) / 2.0)
    _beHigh     = high
    _beLow      = (open < close ? (close + high) / 2.0 : (open + high) / 2.0)
    [_hUp, _hDn, _seLow, _seHigh, _beHigh, _beLow]

// Fallbacks for stddev params if block is compiled standalone
int   _dzLookback = 20
float _dzDevLevel = 3.5

[htfSE_raw, htfBE_raw, htfSELow_raw, htfSEHigh_raw, htfBEHigh_raw, htfBELow_raw] = request.security(
     syminfo.tickerid,
     deDeltaTf,
     f_calcDeltaZones(_dzLookback, _dzDevLevel),
     lookahead=barmerge.lookahead_off
)

// ---------- Chart Delta Zones Memory ----------
seNowChart = showDeltaZones and nz(huntingup, false)
beNowChart = showDeltaZones and nz(huntingdn, false)

var int   lastSEBarChart      = na
var float lastSEZoneLowChart  = na
var float lastSEZoneHighChart = na
var int   lastBEBarChart      = na
var float lastBEZoneHighChart = na
var float lastBEZoneLowChart  = na

if newSessionD != 0
    lastSEBarChart      := na
    lastSEZoneLowChart  := na
    lastSEZoneHighChart := na
    lastBEBarChart      := na
    lastBEZoneHighChart := na
    lastBEZoneLowChart  := na

if seNowChart
    lastSEBarChart      := bar_index
    lastSEZoneLowChart  := low
    lastSEZoneHighChart := (open <= close ? (open + low) / 2.0 : (close + low) / 2.0)
if beNowChart
    lastBEBarChart      := bar_index
    lastBEZoneHighChart := high
    lastBEZoneLowChart  := (open < close ? (close + high) / 2.0 : (open + high) / 2.0)

// ---------- 15m HTF Delta Zones Memory ----------
htfSENow = showDeltaZones and nz(htfSE_raw, false)
htfBENow = showDeltaZones and nz(htfBE_raw, false)

var int   lastSEBarHtf      = na
var float lastSEZoneLowHtf  = na
var float lastSEZoneHighHtf = na
var int   lastBEBarHtf      = na
var float lastBEZoneHighHtf = na
var float lastBEZoneLowHtf  = na

if newSessionD != 0
    lastSEBarHtf      := na
    lastSEZoneLowHtf  := na
    lastSEZoneHighHtf := na
    lastBEBarHtf      := na
    lastBEZoneHighHtf := na
    lastBEZoneLowHtf  := na

bool isNewHtfSE = htfSENow and (na(lastSEZoneLowHtf) or htfSELow_raw != lastSEZoneLowHtf or htfSEHigh_raw != lastSEZoneHighHtf)
bool isNewHtfBE = htfBENow and (na(lastBEZoneHighHtf) or htfBEHigh_raw != lastBEZoneHighHtf or htfBELow_raw != lastBEZoneLowHtf)

if isNewHtfSE
    lastSEBarHtf      := bar_index
    lastSEZoneLowHtf  := htfSELow_raw
    lastSEZoneHighHtf := htfSEHigh_raw

if isNewHtfBE
    lastBEBarHtf      := bar_index
    lastBEZoneHighHtf := htfBEHigh_raw
    lastBEZoneLowHtf  := htfBELow_raw

barsSinceSE_Chart = na(lastSEBarChart) ? 999 : bar_index - lastSEBarChart
barsSinceBE_Chart = na(lastBEBarChart) ? 999 : bar_index - lastBEBarChart

barsSinceSE_Htf   = na(lastSEBarHtf) ? 999 : bar_index - lastSEBarHtf
barsSinceBE_Htf   = na(lastBEBarHtf) ? 999 : bar_index - lastBEBarHtf

bool use15mOnly   = deDeltaSource == "15m HTF"
bool useChartOnly = deDeltaSource == "Chart Timeframe"

int barsSinceSE = use15mOnly ? barsSinceSE_Htf : useChartOnly ? barsSinceSE_Chart : math.min(barsSinceSE_Chart, barsSinceSE_Htf)
int barsSinceBE = use15mOnly ? barsSinceBE_Htf : useChartOnly ? barsSinceBE_Chart : math.min(barsSinceBE_Chart, barsSinceBE_Htf)

float lastSEZoneLow  = use15mOnly ? lastSEZoneLowHtf  : useChartOnly ? lastSEZoneLowChart  : (barsSinceSE_Htf <= barsSinceSE_Chart ? lastSEZoneLowHtf : lastSEZoneLowChart)
float lastSEZoneHigh = use15mOnly ? lastSEZoneHighHtf : useChartOnly ? lastSEZoneHighChart : (barsSinceSE_Htf <= barsSinceSE_Chart ? lastSEZoneHighHtf : lastSEZoneHighChart)
float lastBEZoneHigh = use15mOnly ? lastBEZoneHighHtf : useChartOnly ? lastBEZoneHighChart : (barsSinceBE_Htf <= barsSinceBE_Chart ? lastBEZoneHighHtf : lastBEZoneHighChart)
float lastBEZoneLow  = use15mOnly ? lastBEZoneLowHtf  : useChartOnly ? lastBEZoneLowChart  : (barsSinceBE_Htf <= barsSinceBE_Chart ? lastBEZoneHighHtf : lastBEZoneHighChart)

seRecent = barsSinceSE <= deExhLookback
beRecent = barsSinceBE <= deExhLookback

// ---------- Nearest Daily/Hourly levels and room ----------
// All four levels count from either side: a broken support above price is now resistance,
// and a broken resistance below price is now support.
float lvlA1 = (not na(prevDayHigh)  and prevDayHigh  > close) ? prevDayHigh  : na
float lvlA2 = (not na(prevDayLow)   and prevDayLow   > close) ? prevDayLow   : na
float lvlA3 = (not na(prevHourHigh) and prevHourHigh > close) ? prevHourHigh : na
float lvlA4 = (not na(prevHourLow)  and prevHourLow  > close) ? prevHourLow  : na
float lvlB1 = (not na(prevDayHigh)  and prevDayHigh  < close) ? prevDayHigh  : na
float lvlB2 = (not na(prevDayLow)   and prevDayLow   < close) ? prevDayLow   : na
float lvlB3 = (not na(prevHourHigh) and prevHourHigh < close) ? prevHourHigh : na
float lvlB4 = (not na(prevHourLow)  and prevHourLow  < close) ? prevHourLow  : na

float resAbove = (na(lvlA1) and na(lvlA2) and na(lvlA3) and na(lvlA4)) ? na : math.min(math.min(nz(lvlA1, 1e10), nz(lvlA2, 1e10)), math.min(nz(lvlA3, 1e10), nz(lvlA4, 1e10)))
float supBelow = (na(lvlB1) and na(lvlB2) and na(lvlB3) and na(lvlB4)) ? na : math.max(math.max(nz(lvlB1, -1e10), nz(lvlB2, -1e10)), math.max(nz(lvlB3, -1e10), nz(lvlB4, -1e10)))

float roomUpATR = (na(resAbove) or atrValue <= 0) ? na : (resAbove - close) / atrValue
float roomDnATR = (na(supBelow) or atrValue <= 0) ? na : (close - supBelow) / atrValue

// Delta zones as barriers: a BE zone (sell box) above/around a long, an SE zone (buy box) below/around a short.
float beGapChartATR = (na(lastBEZoneLowChart) or na(lastBEZoneHighChart) or atrValue <= 0 or close > lastBEZoneHighChart) ? na : (lastBEZoneLowChart - close) / atrValue
float seGapChartATR = (na(lastSEZoneLowChart) or na(lastSEZoneHighChart) or atrValue <= 0 or close < lastSEZoneLowChart)  ? na : (close - lastSEZoneHighChart) / atrValue

float beGapHtfATR   = (na(lastBEZoneLowHtf) or na(lastBEZoneHighHtf) or atrValue <= 0 or close > lastBEZoneHighHtf) ? na : (lastBEZoneLowHtf - close) / atrValue
float seGapHtfATR   = (na(lastSEZoneLowHtf) or na(lastSEZoneHighHtf) or atrValue <= 0 or close < lastSEZoneLowHtf)  ? na : (close - lastSEZoneHighHtf) / atrValue

float beZoneGapATR  = use15mOnly ? beGapHtfATR : useChartOnly ? beGapChartATR : (na(beGapChartATR) ? beGapHtfATR : na(beGapHtfATR) ? beGapChartATR : math.min(beGapChartATR, beGapHtfATR))
float seZoneGapATR  = use15mOnly ? seGapHtfATR : useChartOnly ? seGapChartATR : (na(seGapChartATR) ? seGapHtfATR : na(seGapHtfATR) ? seGapChartATR : math.min(seGapChartATR, seGapHtfATR))

// ---------- Shared conditions ----------
volRecent = nz(ta.barssince(volumeSpike), 999) <= deVolBars
adxOK     = adxVal >= deMinAdx and adxRising

// ---------- LONG conditions ----------
L_trend = bullContext
L_adx   = adxOK
L_vwap  = close > dailyVWAP
L_rsi   = rsiValue > 50 and rsiValue <= deRsiMax
L_vol   = volRecent
L_htf   = htfBullish
L_exh   = seRecent and not na(lastSEZoneLow) and close > lastSEZoneLow

// Fresh breakout = broke the N-bar extreme, or crossed a Daily/Hourly level, within the last 3 bars
brokeUpRecent   = close > nBarHigh or nz(ta.barssince(ta.crossover(close,  prevDayHigh) or ta.crossover(close,  prevHourHigh)), 999) <= 2
brokeDownRecent = close < nBarLow  or nz(ta.barssince(ta.crossunder(close, prevDayLow)  or ta.crossunder(close, prevHourLow)),  999) <= 2

extLongATR  = atrValue > 0 ? (close - ema21) / atrValue : 0.0
extShortATR = atrValue > 0 ? (ema21 - close) / atrValue : 0.0

longExtLimit  = ((deBreakoutExempt and brokeUpRecent   and volRecent) or (deExtTrendExempt and tradeDirection ==  1 and tradeQuality == "TREND")) ? deExtHardCap : deMaxExtendATR
shortExtLimit = ((deBreakoutExempt and brokeDownRecent and volRecent) or (deExtTrendExempt and tradeDirection == -1 and tradeQuality == "TREND")) ? deExtHardCap : deMaxExtendATR

L_room  = na(roomUpATR) or roomUpATR >= deMinRoomATR     // open air above counts as room
L_noOpp = barsSinceBE > deVetoBars
L_noExt = extLongATR <= longExtLimit
L_zone  = na(beZoneGapATR) or beZoneGapATR >= deMinRoomATR

// ---------- SHORT conditions ----------
S_trend = bearContext
S_adx   = adxOK
S_vwap  = close < dailyVWAP
S_rsi   = rsiValue < 50 and rsiValue >= (100 - deRsiMax)
S_vol   = volRecent
S_htf   = htfBearish
S_exh   = beRecent and not na(lastBEZoneHigh) and close < lastBEZoneHigh

S_room  = na(roomDnATR) or roomDnATR >= deMinRoomATR
S_noOpp = barsSinceSE > deVetoBars
S_noExt = extShortATR <= shortExtLimit
S_zone  = na(seZoneGapATR) or seZoneGapATR >= deMinRoomATR

// ---------- Extra strength checks (added) ----------
// Index alignment: what is Nifty doing on the same timeframe right now?
// (EMA-based on purpose: index charts often have no volume, which would break a VWAP comparison.)
idxApplies = not str.contains(syminfo.prefix, "MCX")
[idxClose, idxEma9, idxEma21] = request.security(deIdxSym, timeframe.period, [close, ta.ema(close, 9), ta.ema(close, 21)], lookahead=barmerge.lookahead_off)
L_index   = idxClose > idxEma21 and idxEma9 > idxEma21
S_index   = idxClose < idxEma21 and idxEma9 < idxEma21
useIdxEff = useCIndex and idxApplies

// Strong close: the signal candle closes near its high (long) / low (short)
L_close = longWick  >= deCloseStrong
S_close = shortWick >= deCloseStrong

// Cost filter: TP1 must be far enough away to be worth the brokerage, STT and slippage
float tp1DistPct = (not na(tp1) and not na(tradeEntry) and tradeEntry > 0) ? math.abs(tp1 - tradeEntry) / tradeEntry * 100.0 : na
bool  costOK     = na(tp1DistPct) or tp1DistPct >= deMinTP1Pct

// Signal type and time window
bool typeOK   = not deRequireTrend or tradeQuality == "TREND"
bool inWindow = not useSessionGate or not na(time(timeframe.period, deSession, "Asia/Kolkata"))

// Daily limits (counted on the indicator's own trades)
var int   dayGoCount = 0
var int   dayLosses  = 0
var float goEntrySL  = na
if newSessionD != 0
    dayGoCount := 0
    dayLosses  := 0
bool dayLocked  = useDayLimits and (dayLosses >= deMaxLossesDay or dayGoCount >= deMaxGoPerDay)
bool gateBlock  = (deRequireTrend and not typeOK) or not inWindow or dayLocked

// ---------- Score ----------
f_pt(cond, en) => (en and cond) ? 1 : 0

maxPts = (useCTrend ? 1 : 0) + (useCAdx ? 1 : 0) + (useCVwap ? 1 : 0) + (useCRsi ? 1 : 0) + (useCVol ? 1 : 0) + (useCHtf ? 1 : 0) + (useIdxEff ? 1 : 0) + (useCClose ? 1 : 0)

longBase  = f_pt(L_trend, useCTrend) + f_pt(L_adx, useCAdx) + f_pt(L_vwap, useCVwap) + f_pt(L_rsi, useCRsi) + f_pt(L_vol, useCVol) + f_pt(L_htf, useCHtf) + f_pt(L_index, useIdxEff) + f_pt(L_close, useCClose)
shortBase = f_pt(S_trend, useCTrend) + f_pt(S_adx, useCAdx) + f_pt(S_vwap, useCVwap) + f_pt(S_rsi, useCRsi) + f_pt(S_vol, useCVol) + f_pt(S_htf, useCHtf) + f_pt(S_index, useIdxEff) + f_pt(S_close, useCClose)

// Supportive exhaustion is a BONUS point: it is rare, so its absence should not cap the score
longPts   = math.min(maxPts, longBase  + f_pt(L_exh, useCExh))
shortPts  = math.min(maxPts, shortBase + f_pt(S_exh, useCExh))

longPct  = maxPts > 0 ? longPts  / maxPts * 100.0 : 0.0
shortPct = maxPts > 0 ? shortPts / maxPts * 100.0 : 0.0

// ---------- Vetoes ----------
longVeto  = (useVetoRoom and not L_room) or (useVetoExh and not L_noOpp) or (useVetoExt and not L_noExt) or (useVetoZone and not L_zone) or (deVwapMust and not L_vwap) or (useVetoCost and not costOK) or gateBlock
shortVeto = (useVetoRoom and not S_room) or (useVetoExh and not S_noOpp) or (useVetoExt and not S_noExt) or (useVetoZone and not S_zone) or (deVwapMust and not S_vwap) or (useVetoCost and not costOK) or gateBlock

// ---------- Trigger (your original signals) ----------
longSignalNow  = confirmedLong  or confirmedPullbackLong
shortSignalNow = confirmedShort or confirmedPullbackShort
longTrigger    = nz(ta.barssince(longSignalNow),  999) <= deTriggerBars
shortTrigger   = nz(ta.barssince(shortSignalNow), 999) <= deTriggerBars

longGo  = longTrigger  and not longVeto  and longPct  >= deMinScorePct
shortGo = shortTrigger and not shortVeto and shortPct >= deMinScorePct

// ---------- Final decision ----------
bool   domLong   = (longGo and not shortGo) ? true : (shortGo and not longGo) ? false : longPct >= shortPct
float  domPct    = domLong ? longPct : shortPct
bool   domGo     = domLong ? longGo : shortGo
bool   domVeto   = domLong ? longVeto : shortVeto
string sideTxt   = domLong ? "BUY" : "SELL"

string decision  = "NO TRADE"
color  decColor  = dashGray

if domGo
    decision := sideTxt + ((domPct >= deAGradePct and tradeQuality == "TREND") ? "  GO (A)" : "  GO (B)")
    decColor := domLong ? dashGreenStrong : dashRedStrong
else if domVeto and domPct >= deMinScorePct
    decision := "SKIP (" + sideTxt + " vetoed)"
    decColor := color.orange
else if domPct >= deMinScorePct
    decision := "WAIT (" + sideTxt + " forming)"
    decColor := dashYellow

// ---------- Trade latch ----------
// Vetoes are ENTRY filters. Once GO fires, price moving in your favour makes it MORE extended,
// which would flip the panel to SKIP on the next candle even though you are already in.
// So after GO the panel shows IN TRADE until the stop is hit, all targets are done,
// the opposite signal fires, or a new day starts.
var int   goSide = 0
var int   goBar  = na
var float goPct  = na
var bool  goA    = false

entryLongNow  = longGo  and not nz(longGo[1],  false)
entryShortNow = shortGo and not nz(shortGo[1], false)

bool slHit   = goSide != 0 and bar_index > nz(goBar, bar_index) and not na(activeSL) and ((goSide == 1 and low <= activeSL) or (goSide == -1 and high >= activeSL))
bool tgtDone = goSide != 0 and nextTargetText == "TARGETS COMPLETE"
bool flipped = (goSide == 1 and shortSignalNow) or (goSide == -1 and longSignalNow)

if slHit and activeSL == goEntrySL
    dayLosses += 1

if newSessionD != 0 or slHit or tgtDone or flipped
    goSide := 0

if entryLongNow
    goSide := 1
    goBar  := bar_index
    goPct  := longPct
    goA    := longPct >= deAGradePct and tradeQuality == "TREND"
    goEntrySL := activeSL
    dayGoCount += 1
if entryShortNow
    goSide := -1
    goBar  := bar_index
    goPct  := shortPct
    goA    := shortPct >= deAGradePct and tradeQuality == "TREND"
    goEntrySL := activeSL
    dayGoCount += 1

if goSide != 0
    decision := (goSide == 1 ? "BUY" : "SELL") + " IN TRADE (" + (goA ? "A" : "B") + ")"
    decColor := goSide == 1 ? dashGreenStrong : dashRedStrong

// ---------- Two extra rows on your MAIN dashboard ----------
// Lists every veto that is currently blocking the side being evaluated
string vetoTxt = ""
float extATR = domLong ? extLongATR : extShortATR
float extLim = domLong ? longExtLimit : shortExtLimit
if useVetoRoom and not (domLong ? L_room : S_room)
    vetoTxt += (domLong ? "Res " + str.tostring(roomUpATR, "#.#") : "Sup " + str.tostring(roomDnATR, "#.#")) + "/" + str.tostring(deMinRoomATR, "#.#") + " ATR  "
if useVetoExh and not (domLong ? L_noOpp : S_noOpp)
    vetoTxt += (domLong ? "BE " + str.tostring(barsSinceBE) : "SE " + str.tostring(barsSinceSE)) + " bars ago  "
if useVetoExt and not (domLong ? L_noExt : S_noExt)
    vetoTxt += "Ext " + str.tostring(extATR, "#.#") + "/" + str.tostring(extLim, "#.#") + " ATR  "
if useVetoZone and not (domLong ? L_zone : S_zone)
    vetoTxt += (domLong ? "BE zone " + str.tostring(beZoneGapATR, "#.#") : "SE zone " + str.tostring(seZoneGapATR, "#.#")) + "/" + str.tostring(deMinRoomATR, "#.#") + " ATR  "
if deVwapMust and not (domLong ? L_vwap : S_vwap)
    vetoTxt += (domLong ? "Below VWAP  " : "Above VWAP  ")
if useVetoCost and not costOK
    vetoTxt += "TP1 " + str.tostring(tp1DistPct, "#.##") + "%<" + str.tostring(deMinTP1Pct, "#.##") + "%  "
if deRequireTrend and not typeOK
    vetoTxt += "Scalp signal  "
if not inWindow
    vetoTxt += "Outside window  "
if dayLocked
    vetoTxt += "Day limit (" + str.tostring(dayLosses) + "L/" + str.tostring(dayGoCount) + "GO)  "
bool vetoClear = vetoTxt == ""
if vetoClear
    vetoTxt := "Clear"

if goSide != 0
    vetoTxt := "Cleared at entry (" + str.tostring(goPct, "#") + "%)"
    vetoClear := true

if showMainRows and barstate.islast
    table.cell(tableInfo, 0, 15, "DECISION", bgcolor=decColor, text_color=color.black, text_size=dashboardSize)
    table.cell(tableInfo, 1, 15, decision,   bgcolor=decColor, text_color=color.black, text_size=dashboardSize)
    table.cell(tableInfo, 0, 16, "Veto (" + sideTxt + " " + str.tostring(domPct, "#") + "%)", bgcolor=dashYellow, text_color=color.black, text_size=dashboardSize)
    table.cell(tableInfo, 1, 16, vetoTxt, bgcolor=vetoClear ? dashGreenStrong : dashRedStrong, text_color=color.black, text_size=dashboardSize)

// ---------- Separate full checklist panel (optional) ----------
var table dePanel = na

f_row(row, txt, ok, en) =>
    table.cell(dePanel, 0, row, txt, bgcolor=dashYellow, text_color=color.black, text_size=dashboardSize, text_halign=text.align_left)
    table.cell(dePanel, 1, row, en ? (ok ? "✓" : "✗") : "off", bgcolor=en ? (ok ? dashGreenStrong : dashRedStrong) : dashGray, text_color=color.black, text_size=dashboardSize)

f_info(row, lbl, txt) =>
    table.cell(dePanel, 0, row, lbl, bgcolor=dashYellow, text_color=color.black, text_size=dashboardSize, text_halign=text.align_left)
    table.cell(dePanel, 1, row, txt, bgcolor=dashGray, text_color=color.black, text_size=dashboardSize)

if showSepPanel and barstate.islast
    if na(dePanel)
        tblPos = switch dePanelPos
            "top_left"      => position.top_left
            "top_center"    => position.top_center
            "top_right"     => position.top_right
            "bottom_left"   => position.bottom_left
            "bottom_center" => position.bottom_center
            "center_left"   => position.middle_left
            =>                 position.bottom_right
        dePanel := table.new(tblPos, 2, 25, border_width=1)

    table.cell(dePanel, 0, 0, "DECISION ENGINE", bgcolor=color.rgb(60, 60, 60), text_color=color.white, text_size=dashboardSize)
    table.cell(dePanel, 1, 0, "L " + str.tostring(longPct, "#") + "% | S " + str.tostring(shortPct, "#") + "%", bgcolor=color.rgb(60, 60, 60), text_color=color.white, text_size=dashboardSize)

    table.cell(dePanel, 0, 1, "DECISION", bgcolor=decColor, text_color=color.black, text_size=dashboardSize)
    table.cell(dePanel, 1, 1, decision, bgcolor=decColor, text_color=color.black, text_size=dashboardSize)

    table.cell(dePanel, 0, 2, "Evaluating " + sideTxt, bgcolor=dashYellow, text_color=color.black, text_size=dashboardSize)
    table.cell(dePanel, 1, 2, "Score " + str.tostring(domPct, "#") + "% (min " + str.tostring(deMinScorePct, "#") + ")", bgcolor=dashGray, text_color=color.black, text_size=dashboardSize)

    f_row(3, "Signal fired (<=" + str.tostring(deTriggerBars) + " bars)", domLong ? longTrigger : shortTrigger, true)

    f_row(4,  "Trend: EMA9/21 + DI",       domLong ? L_trend : S_trend, useCTrend)
    f_row(5,  "ADX >= " + str.tostring(deMinAdx, "#") + " & rising", domLong ? L_adx : S_adx, useCAdx)
    f_row(6,  "Price on right side of VWAP", domLong ? L_vwap : S_vwap, useCVwap)
    f_row(7,  "RSI not chasing",           domLong ? L_rsi : S_rsi, useCRsi)
    f_row(8,  "Recent volume spike",       domLong ? L_vol : S_vol, useCVol)
    f_row(9,  "15m HTF aligned",           domLong ? L_htf : S_htf, useCHtf)
    f_row(10, "Index aligned",             domLong ? L_index : S_index, useIdxEff)
    f_row(11, "Strong candle close",       domLong ? L_close : S_close, useCClose)
    f_row(12, domLong ? "Bonus: SE zone holding" : "Bonus: BE zone holding", domLong ? L_exh : S_exh, useCExh)

    f_row(13, "VETO clear: room to next level", domLong ? L_room : S_room, useVetoRoom)
    f_row(14, domLong ? "VETO clear: no recent BE" : "VETO clear: no recent SE", domLong ? L_noOpp : S_noOpp, useVetoExh)
    f_row(15, "VETO clear: not extended from EMA21", domLong ? L_noExt : S_noExt, useVetoExt)
    f_row(16, "VETO clear: TP1 covers costs", costOK, useVetoCost)
    f_row(17, "Limits clear (day / window / type)", not gateBlock, true)
    f_row(18, domLong ? "VETO clear: no BE zone in the way" : "VETO clear: no SE zone in the way", domLong ? L_zone : S_zone, useVetoZone)
    f_row(19, "VETO clear: right side of VWAP", domLong ? L_vwap : S_vwap, deVwapMust)

    f_info(20, "Resistance above", na(resAbove) ? "open air" : str.tostring(resAbove, "#.##") + "  (" + str.tostring(roomUpATR, "#.#") + " ATR)")
    f_info(21, "Support below",    na(supBelow) ? "open air" : str.tostring(supBelow, "#.##") + "  (" + str.tostring(roomDnATR, "#.#") + " ATR)")

    exhTxt = (barsSinceSE > deExhLookback and barsSinceBE > deExhLookback) ? "none" : barsSinceSE <= barsSinceBE ? "SE bull " + str.tostring(barsSinceSE) + " bars ago" : "BE bear " + str.tostring(barsSinceBE) + " bars ago"
    f_info(22, "Last exhaustion", exhTxt)
    f_info(23, "Signal type", tradeQuality)
    f_info(24, "Original status", dashboardStatus)

// ---------- Chart markers ----------
goLongNew   = longGo  and not nz(longGo[1],  false)
goShortNew  = shortGo and not nz(shortGo[1], false)
blockedLong  = longSignalNow  and (longVeto  or longPct  < deMinScorePct)
blockedShort = shortSignalNow and (shortVeto or shortPct < deMinScorePct)

plotshape(showGoMarkers and goLongNew,   title="GO Long",  style=shape.triangleup,   location=location.belowbar, color=color.lime,   size=size.tiny, text="GO")
plotshape(showGoMarkers and goShortNew,  title="GO Short", style=shape.triangledown, location=location.abovebar, color=color.red,    size=size.tiny, text="GO")
plotshape(showGoMarkers and blockedLong,  title="Blocked Long",  style=shape.xcross, location=location.belowbar, color=color.gray, size=size.tiny, text="X")
plotshape(showGoMarkers and blockedShort, title="Blocked Short", style=shape.xcross, location=location.abovebar, color=color.gray, size=size.tiny, text="X")

// Data Window columns (handy for journaling / backtest tagging)
plot(longPct,  title="DE Long Score %",  display=display.data_window)
plot(shortPct, title="DE Short Score %", display=display.data_window)

// ---------- Alerts ----------
alertcondition(goLongNew,  title="Decision Engine: GO LONG",  message="GO LONG on {{ticker}} at {{close}} - all checks passed")
alertcondition(goShortNew, title="Decision Engine: GO SHORT", message="GO SHORT on {{ticker}} at {{close}} - all checks passed")
alertcondition(blockedLong or blockedShort, title="Decision Engine: Signal BLOCKED", message="Signal on {{ticker}} at {{close}} was BLOCKED by the decision engine")
// =====================================================================================
