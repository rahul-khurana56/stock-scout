//@version=5
strategy("Profit GeNIE 1 - Institutional Options Engine", shorttitle="PG1-PRO", overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.fixed,
     default_qty_value=15,
     commission_type=strategy.commission.cash_per_order,
     commission_value=20,
     slippage=1)

// =============================================================================
// 1. STRATEGY SELECTION & INPUTS
// =============================================================================
entryMode           = input.string("Trend Pullback (70%+ High Probability)", title="Entry Style", options=["Trend Pullback (70%+ High Probability)", "Momentum Breakout (Classic GeNIE)"], group="Strategy Mode")
tradeMode           = input.string("High-Quality TREND Only", title="Quality Filter", options=["High-Quality TREND Only", "All Signals (High R:R)"], group="Strategy Mode")

// --- Indicator Inputs ---
rsiLength           = input.int(14,     title="RSI Length",                    minval=1, group="Indicators")
adxLength           = input.int(14,     title="ADX Length",                    minval=1, group="Indicators")
fastEmaLength       = input.int(21,     title="Fast EMA (Pullback Base)",      minval=1, group="Indicators")
slowEmaLength       = input.int(50,     title="Slow EMA (Trend Filter)",       minval=1, group="Indicators")
genieEmaLength      = input.int(33,     title="Classic GeNIE EMA",             minval=1, group="Indicators")
minBarsCooldown     = input.int(12,     title="Min Bars Between Signals",      minval=1, group="Indicators")
breakoutLookback    = input.int(15,     title="Breakout Lookback (bars)",      minval=2, group="Indicators")

// --- Macro Trend Alignment ---
useHTFFilter        = input.bool(true,  title="Require 15m HTF Alignment",     group="Macro Alignment")
htfTimeframe        = input.timeframe("15", title="HTF Timeframe",             group="Macro Alignment")
useVWAPFilter       = input.bool(true,  title="Require Daily VWAP Side",       group="Macro Alignment")

// --- Options Buyer Timing Windows (Avoid Midday Theta Decay) ---
useSessionFilter    = input.bool(true,  title="Skip Midday Theta Decay (11:30 - 13:15)", group="Timing Windows")
morningSession      = input.session("0930-1115:23456", title="Morning Momentum Window", group="Timing Windows")
afternoonSession    = input.session("1315-1500:23456", title="Afternoon Momentum Window", group="Timing Windows")

// --- Precision Targets & Risk Management ---
slAtrMultiplier     = input.float(0.8,  title="Stop Loss (Spot x ATR)",        step=0.1, minval=0.3, group="Take-Profit & Risk Management")
tp1AtrMultiplier    = input.float(0.7,  title="TP1 (Spot x ATR) - 75% Lots",   step=0.1, minval=0.4, group="Take-Profit & Risk Management")
tp2AtrMultiplier    = input.float(2.0,  title="TP2 (Spot x ATR) - 25% Runner", step=0.1, minval=1.0, group="Take-Profit & Risk Management")
moveSlToBreakeven   = input.bool(true,  title="Auto-Move SL to Breakeven (+Buffer) on TP1", group="Take-Profit & Risk Management")
estDelta            = input.float(0.52, title="Estimated ATM Option Delta",    step=0.02, minval=0.3, maxval=0.8, group="Options Simulation")

// --- Backtest Date Range ---
startDate = input.time(timestamp("2024-01-01T00:00:00"), title="Backtest Start", group="Date Range")
endDate   = input.time(timestamp("2027-12-31T00:00:00"), title="Backtest End", group="Date Range")
inDateRange = time >= startDate and time <= endDate

// =============================================================================
// 2. TIMING WINDOW & CORE CALCULATIONS
// =============================================================================
inMorning   = not na(time(timeframe.period, morningSession, "Asia/Kolkata"))
inAfternoon = not na(time(timeframe.period, afternoonSession, "Asia/Kolkata"))
inTimingWindow = not useSessionFilter or inMorning or inAfternoon

// EMAs
ema21 = ta.ema(close, fastEmaLength)
ema50 = ta.ema(close, slowEmaLength)
ema33High = ta.ema(close, genieEmaLength)
ema33Low  = ta.ema(low,   genieEmaLength)

// RSI
rsiValue = ta.rsi(close, rsiLength)

// ADX / DMI
getADXDI(length) =>
    trueRange  = ta.tr(true)
    changeHigh = ta.change(high)
    changeLow  = -ta.change(low)
    plusDM     = na(changeHigh) ? na : (changeHigh > changeLow and changeHigh > 0 ? changeHigh : 0)
    minusDM    = na(changeLow)  ? na : (changeLow > changeHigh and changeLow  > 0 ? changeLow  : 0)
    atr        = ta.rma(trueRange, length)
    plusDI     = 100 * ta.rma(plusDM,  length) / atr
    minusDI    = 100 * ta.rma(minusDM, length) / atr
    dx         = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
    adxVal     = ta.rma(dx, length)
    [adxVal, plusDI, minusDI]

[adxVal, plusDiVal, minusDiVal] = getADXDI(adxLength)

// HTF Alignment
htfEMA = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, fastEmaLength), lookahead=barmerge.lookahead_off)
[htfADX, htfPlusDI, htfMinusDI] = request.security(syminfo.tickerid, htfTimeframe, getADXDI(adxLength), lookahead=barmerge.lookahead_off)
htfClose = request.security(syminfo.tickerid, htfTimeframe, close, lookahead=barmerge.lookahead_off)

htfBullish = htfClose > htfEMA and htfPlusDI > htfMinusDI
htfBearish = htfClose < htfEMA and htfMinusDI > htfPlusDI

// Daily VWAP
dailyVWAP = ta.vwap(hlc3)

// ATR Volatility
atrLength = timeframe.period == "5" ? 14 : timeframe.period == "15" ? 10 : 14
atrValue  = ta.atr(atrLength)

// Daily Open & Breakout Bands
var float dailyOpen = na
if ta.change(time("D")) != 0
    dailyOpen := open
if na(dailyOpen)
    dailyOpen := open

adjustedChange =
     str.contains(syminfo.ticker, "BANK")  ? 0.0017 :
     str.contains(syminfo.ticker, "NIFTY") ? 0.0025 :
     str.contains(syminfo.prefix, "MCX")   ? 0.0040 :
     str.contains(syminfo.ticker, "SENSEX") ? 0.0015 : 0.0025

bbz = dailyOpen * (1 + adjustedChange)
bz  = dailyOpen * (1 - adjustedChange)

nBarHigh = ta.highest(high, breakoutLookback)[1]
nBarLow  = ta.lowest(low, breakoutLookback)[1]

// =============================================================================
// 3. SIGNAL GENERATION (PULLBACK vs BREAKOUT ENGINE)
// =============================================================================
macroLongOK  = (not useHTFFilter or htfBullish) and (not useVWAPFilter or close > dailyVWAP) and ema21 >= ema50
macroShortOK = (not useHTFFilter or htfBearish) and (not useVWAPFilter or close < dailyVWAP) and ema21 <= ema50

// --- MODE A: HIGH-PROBABILITY TREND PULLBACK ---
pullbackDipLong    = low <= (ema21 + (atrValue * 0.15)) and close > ema50 and rsiValue >= 45 and rsiValue <= 65
reversalTriggerLong = close > open and close > ema21 and close >= high[1] and plusDiVal > minusDiVal

pullbackRallyShort  = high >= (ema21 - (atrValue * 0.15)) and close < ema50 and rsiValue <= 55 and rsiValue >= 35
reversalTriggerShort = close < open and close < ema21 and close <= low[1] and minusDiVal > plusDiVal

pullbackLongSignal  = macroLongOK and pullbackDipLong and reversalTriggerLong
pullbackShortSignal = macroShortOK and pullbackRallyShort and reversalTriggerShort

// --- MODE B: CLASSIC GENIE BREAKOUT ENGINE ---
rsiScore      = rsiValue >= 65 ? 1.0 : rsiValue >= 55 ? 0.7 : rsiValue >= 50 ? 0.4 : 0.0
adxScore      = adxVal >= 30 ? 1.0 : adxVal >= 20 ? 0.6 : 0.3
diSpread      = plusDiVal - minusDiVal
trendScore    = math.round((rsiScore + adxScore + (math.max(math.min(diSpread, 30), 0) / 30) + (close > ema33High ? 1.0 : 0.0)) * 10) / 10

bearDiSpread  = minusDiVal - plusDiVal
shortTrendScore = math.round(((rsiValue <= 35 ? 1.0 : rsiValue <= 45 ? 0.7 : 0.4) + adxScore + (math.max(math.min(bearDiSpread, 30), 0) / 30) + (close < ema33Low ? 1.0 : 0.0)) * 10) / 10

breakoutLongSignal  = close > ema33High and plusDiVal > minusDiVal and rsiValue > 55 and trendScore >= 2.5 and close > bbz and close > nBarHigh and macroLongOK
breakoutShortSignal = close < ema33Low and minusDiVal > plusDiVal and rsiValue < 45 and shortTrendScore >= 2.5 and close < bz and close < nBarLow and macroShortOK

// Combined Trigger
isPullbackMode = entryMode == "Trend Pullback (70%+ High Probability)"
rawLongSignal  = isPullbackMode ? pullbackLongSignal : breakoutLongSignal
rawShortSignal = isPullbackMode ? pullbackShortSignal : breakoutShortSignal

// Cooldown Management
var int lastLongBar  = -100
var int lastShortBar = -100

validLongEntry  = barstate.isconfirmed and rawLongSignal and inDateRange and inTimingWindow and (bar_index - lastLongBar >= minBarsCooldown)
validShortEntry = barstate.isconfirmed and rawShortSignal and inDateRange and inTimingWindow and (bar_index - lastShortBar >= minBarsCooldown)

if validLongEntry
    lastLongBar := bar_index

if validShortEntry
    lastShortBar := bar_index

// =============================================================================
// 4. PRECISION POSITION & BRACKET MANAGEMENT
// =============================================================================
var float tradeEntry = na
var float activeSL   = na
var float tp1        = na
var float tp2        = na
var bool tp1Hit      = false
var bool tp2Hit      = false

// --- ENTER LONG (BUY ATM CE) ---
if validLongEntry and strategy.position_size == 0
    tradeEntry := close
    tp1Hit     := false
    tp2Hit     := false

    activeSL := isPullbackMode ? math.min(low, low[1]) - (atrValue * 0.2) : tradeEntry - (atrValue * slAtrMultiplier)
    activeSL := math.max(activeSL, tradeEntry - (atrValue * 0.9))

    tp1 := tradeEntry + (atrValue * tp1AtrMultiplier)
    tp2 := tradeEntry + (atrValue * tp2AtrMultiplier)

    strategy.entry("Long", strategy.long, comment="BUY ATM CE")

// --- ENTER SHORT (BUY ATM PE) ---
if validShortEntry and strategy.position_size == 0
    tradeEntry := close
    tp1Hit     := false
    tp2Hit     := false

    activeSL := isPullbackMode ? math.max(high, high[1]) + (atrValue * 0.2) : tradeEntry + (atrValue * slAtrMultiplier)
    activeSL := math.min(activeSL, tradeEntry + (atrValue * 0.9))

    tp1 := tradeEntry - (atrValue * tp1AtrMultiplier)
    tp2 := tradeEntry - (atrValue * tp2AtrMultiplier)

    strategy.entry("Short", strategy.short, comment="BUY ATM PE")

// --- LONG TRADE MANAGEMENT (CE POSITION) ---
if strategy.position_size > 0
    // TP1: Harvest 75% Option Lots at TP1 & Shift SL to Breakeven (+Buffer)
    if high >= tp1 and not tp1Hit
        strategy.close("Long", qty_percent=75, comment="TP1 CE (+0.7 ATR)")
        tp1Hit := true
        if moveSlToBreakeven
            activeSL := math.max(activeSL, tradeEntry + (atrValue * 0.05))

    // TP2: Harvest remaining 25% CE Runner at TP2
    if high >= tp2 and tp1Hit and not tp2Hit
        strategy.close("Long", qty_percent=100, comment="TP2 CE (+2.0 ATR)")
        tp2Hit := true

    strategy.exit("SL CE", "Long", stop=activeSL)

// --- SHORT TRADE MANAGEMENT (PE POSITION) ---
if strategy.position_size < 0
    // TP1: Harvest 75% Option Lots at TP1 & Shift SL to Breakeven (-Buffer)
    if low <= tp1 and not tp1Hit
        strategy.close("Short", qty_percent=75, comment="TP1 PE (-0.7 ATR)")
        tp1Hit := true
        if moveSlToBreakeven
            activeSL := math.min(activeSL, tradeEntry - (atrValue * 0.05))

    // TP2: Harvest remaining 25% PE Runner at TP2
    if low <= tp2 and tp1Hit and not tp2Hit
        strategy.close("Short", qty_percent=100, comment="TP2 PE (-2.0 ATR)")
        tp2Hit := true

    strategy.exit("SL PE", "Short", stop=activeSL)

// Force Flat Outside Date Range
if not inDateRange and strategy.position_size != 0
    strategy.close_all(comment="Out of Date Range")

// =============================================================================
// 5. CHART VISUALS & PERFORMANCE HUD TABLE
// =============================================================================
plot(ema21,     color=color.new(#38bdf8, 10), title="21 EMA (Support/Pullback)", linewidth=2)
plot(ema50,     color=color.new(#f59e0b, 10), title="50 EMA (Trend Baseline)",   linewidth=2)
plot(dailyVWAP, color=color.new(#ec4899, 0),  title="Daily VWAP",                linewidth=2)

// Visual Target & SL Markers during open trades
plot(strategy.position_size != 0 ? tp1 : na,      title="TP1 Level",  color=color.blue,    style=plot.style_circles, linewidth=2)
plot(strategy.position_size != 0 ? tp2 : na,      title="TP2 Level",  color=color.teal,    style=plot.style_circles, linewidth=2)
plot(strategy.position_size != 0 ? activeSL : na, title="Active SL",  color=color.fuchsia, style=plot.style_circles, linewidth=2)

// High-Visibility Options Action Labels
plotshape(validLongEntry and strategy.position_size == 0,  title="BUY ATM CE Signal", style=shape.labelup,   location=location.belowbar, color=color.new(#10b981, 0), text="BUY ATM CE", textcolor=color.white, size=size.small)
plotshape(validShortEntry and strategy.position_size == 0, title="BUY ATM PE Signal", style=shape.labeldown, location=location.abovebar, color=color.new(#ef4444, 0), text="BUY ATM PE", textcolor=color.white, size=size.small)

// --- SYSTEM PERFORMANCE HUD TABLE ---
var table hud = table.new(position.top_right, 2, 7, bgcolor=color.new(#07111a, 15), border_color=color.new(#38bdf8, 40), border_width=1)
if barstate.islast
    float winRate = strategy.closedtrades > 0 ? (strategy.wintrades / strategy.closedtrades) * 100 : 0
    float pf = strategy.grossloss != 0 ? strategy.grossprofit / strategy.grossloss : strategy.grossprofit > 0 ? 99.9 : 0
    float lotSize = str.contains(syminfo.ticker, "BANK") ? 15 : str.contains(syminfo.ticker, "SENSEX") ? 10 : 25
    float estOptionPoints = (strategy.netprofit / lotSize) * estDelta

    table.cell(hud, 0, 0, "PROFIT GeNIE",     text_color=color.white, bgcolor=color.new(#0284c7, 0))
    table.cell(hud, 1, 0, isPullbackMode ? "PULLBACK ENGINE" : "BREAKOUT ENGINE", text_color=color.white, bgcolor=color.new(#0284c7, 0))
    
    table.cell(hud, 0, 1, "Mode", text_color=color.white)
    table.cell(hud, 1, 1, isPullbackMode ? "70%+ Pullback" : "Breakout", text_color=color.yellow)

    table.cell(hud, 0, 2, "Closed Trades", text_color=color.white)
    table.cell(hud, 1, 2, str.tostring(strategy.closedtrades), text_color=color.white)
    
    table.cell(hud, 0, 3, "Win Rate (%)", text_color=color.white)
    table.cell(hud, 1, 3, str.tostring(winRate, "#.##") + "%", text_color=winRate >= 50 ? color.green : color.orange)
    
    table.cell(hud, 0, 4, "Profit Factor", text_color=color.white)
    table.cell(hud, 1, 4, str.tostring(pf, "#.##"), text_color=pf >= 1.0 ? color.green : color.red)
    
    table.cell(hud, 0, 5, "Net PnL (₹)", text_color=color.white)
    table.cell(hud, 1, 5, (strategy.netprofit >= 0 ? "+" : "") + str.tostring(strategy.netprofit, "#.##"), text_color=strategy.netprofit >= 0 ? color.green : color.red)

    table.cell(hud, 0, 6, "Est. Option Pts", text_color=color.white)
    table.cell(hud, 1, 6, (estOptionPoints >= 0 ? "+" : "") + str.tostring(estOptionPoints, "#.##") + " pts", text_color=estOptionPoints >= 0 ? color.green : color.red)
